@{
    ViewData["Title"] = "Dashboard - Vendedor";
    Layout = "_LayoutVendedor";
    var nombreUsuario = ViewBag.NombreUsuario ?? "Vendedor";
    var fechaActual = DateTime.Now;
    var ventasHoy = ViewBag.VentasHoy ?? 0;
    var cantidadVentasHoy = ViewBag.CantidadVentasHoy ?? 0;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Óptica Claridad</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', sans-serif;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                min-height: 100vh;
                padding: 20px;
            }

            .dashboard-wrapper {
                max-width: 1200px;
                margin: 0 auto;
            }

            /* Header */
            .modern-header {
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(10px);
                border-radius: 24px;
                padding: 24px 32px;
                margin-bottom: 32px;
                box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.1);
            }

            .header-content {
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 20px;
            }

            .logo-area {
                display: flex;
                align-items: center;
                gap: 15px;
            }

            .logo-icon {
                width: 50px;
                height: 50px;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                border-radius: 15px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 24px;
                color: white;
            }

            .logo-text h2 {
                font-size: 1.5rem;
                font-weight: 700;
                color: #1a1a2e;
                margin: 0;
            }

            .logo-text p {
                font-size: 0.8rem;
                color: #666;
                margin: 0;
            }

            .user-info {
                display: flex;
                align-items: center;
                gap: 20px;
            }

            .user-badge {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 8px 16px;
                background: #f0f0f0;
                border-radius: 40px;
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-weight: bold;
            }

            .datetime {
                text-align: right;
            }

            .date {
                font-size: 0.85rem;
                color: #666;
            }

            .time {
                font-size: 1.2rem;
                font-weight: 700;
                color: #1a1a2e;
            }

            .role-badge {
                display: inline-block;
                padding: 4px 12px;
                background: #e8f5e9;
                color: #2e7d32;
                border-radius: 20px;
                font-size: 0.7rem;
                font-weight: 600;
                margin-left: 10px;
            }

            /* Stats Cards */
            .stats-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
                gap: 24px;
                margin-bottom: 32px;
            }

            .stat-card {
                background: white;
                border-radius: 20px;
                padding: 24px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
            }

                .stat-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 4px;
                    height: 100%;
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                }

                .stat-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
                }

            .stat-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 16px;
            }

            .stat-title {
                font-size: 0.85rem;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: #888;
                font-weight: 600;
            }

            .stat-icon {
                width: 48px;
                height: 48px;
                background: linear-gradient(135deg, #667eea20 0%, #764ba220 100%);
                border-radius: 15px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 24px;
            }

            .stat-value {
                font-size: 2rem;
                font-weight: 800;
                color: #1a1a2e;
                margin-bottom: 8px;
            }

            .stat-sub {
                font-size: 0.75rem;
                color: #888;
            }

            /* Sección de acciones rápidas */
            .section-title {
                font-size: 1.3rem;
                font-weight: 700;
                color: white;
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .actions-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                gap: 20px;
                margin-bottom: 32px;
            }

            .action-card {
                background: white;
                border-radius: 18px;
                padding: 20px;
                transition: all 0.3s ease;
                cursor: pointer;
                text-decoration: none;
                color: inherit;
                display: flex;
                align-items: center;
                gap: 18px;
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
                border: 1px solid #eee;
            }

                .action-card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
                    border-color: #667eea;
                }

            .action-icon {
                width: 55px;
                height: 55px;
                background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
                border-radius: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 28px;
                color: #667eea;
            }

            .action-info h4 {
                font-size: 1rem;
                font-weight: 700;
                margin: 0 0 5px 0;
                color: #1a1a2e;
            }

            .action-info p {
                font-size: 0.75rem;
                color: #888;
                margin: 0;
            }

            /* Top Productos */
            .products-card {
                background: white;
                border-radius: 20px;
                padding: 24px;
                margin-bottom: 32px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            }

            .products-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 20px;
                padding-bottom: 15px;
                border-bottom: 2px solid #f0f0f0;
            }

                .products-header h3 {
                    font-size: 1.2rem;
                    font-weight: 700;
                    color: #1a1a2e;
                    margin: 0;
                }

            .product-item {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 15px 0;
                border-bottom: 1px solid #f0f0f0;
                transition: background 0.2s;
            }

                .product-item:hover {
                    background: #f8f9ff;
                    border-radius: 10px;
                    padding-left: 10px;
                    padding-right: 10px;
                }

            .product-name {
                font-weight: 500;
                color: #495057;
            }

            .product-qty {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                padding: 5px 15px;
                border-radius: 20px;
                font-size: 0.8rem;
                font-weight: 600;
            }

            .empty-products {
                text-align: center;
                padding: 40px;
                color: #888;
            }

            /* Mensaje motivacional */
            .motivational-card {
                background: white;
                border-radius: 20px;
                padding: 20px 24px;
                margin-bottom: 32px;
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
                border-left: 4px solid #667eea;
            }

                .motivational-card p {
                    margin: 0;
                    font-size: 0.95rem;
                    color: #495057;
                }

            /* Botones secundarios */
            .footer-actions {
                display: flex;
                gap: 15px;
                justify-content: center;
                margin-top: 20px;
            }

            .btn-outline {
                padding: 10px 24px;
                border-radius: 40px;
                font-weight: 600;
                font-size: 0.85rem;
                text-decoration: none;
                transition: all 0.3s;
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

            .btn-outline-light {
                background: transparent;
                border: 2px solid white;
                color: white;
            }

                .btn-outline-light:hover {
                    background: white;
                    color: #667eea;
                }

            .btn-outline-dark {
                background: transparent;
                border: 2px solid #667eea;
                color: #667eea;
            }

                .btn-outline-dark:hover {
                    background: #667eea;
                    color: white;
                }

            @@media (max-width: 768px) {
                body {
                    padding: 10px;
                }

                .header-content {
                    flex-direction: column;
                    text-align: center;
                }

                .user-info {
                    flex-direction: column;
                }

                .datetime {
                    text-align: center;
                }

                .stats-grid {
                    grid-template-columns: 1fr;
                }

                .actions-grid {
                    grid-template-columns: 1fr;
                }
            }
    </style>
</head>
<body>
    <div class="dashboard-wrapper">
        <!-- Header Moderno -->
        <div class="modern-header">
            <div class="header-content">
                <div class="logo-area">
                    <div class="logo-icon"><i class="bi bi-eye-fill"></i></div>
                    <div class="logo-text">
                        <h2>Óptica Claridad</h2>
                        <p>Panel de Vendedor</p>
                    </div>
                </div>
                <div class="user-info">
                    <div class="user-badge">
                        <div class="user-avatar">@nombreUsuario.Substring(0, 1).ToUpper()</div>
                        <div>
                            <strong>@nombreUsuario</strong>
                            <span class="role-badge"><i class="bi bi-person-badge"></i> VENDEDOR</span>
                        </div>
                    </div>
                    <div class="datetime">
                        <div class="date">@fechaActual.ToString("dddd, dd MMMM yyyy")</div>
                        <div class="time" id="horaActual">--:--:--</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">VENTAS HOY</span>
                    <div class="stat-icon"><i class="bi bi-currency-dollar"></i></div>
                </div>
                <div class="stat-value">@ventasHoy.ToString("C")</div>
                <div class="stat-sub">Total en ventas</div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">TRANSACCIONES</span>
                    <div class="stat-icon"><i class="bi bi-cart"></i></div>
                </div>
                <div class="stat-value">@cantidadVentasHoy</div>
                <div class="stat-sub">Ventas realizadas hoy</div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">TICKET PROMEDIO</span>
                    <div class="stat-icon"><i class="bi bi-receipt"></i></div>
                </div>
                <div class="stat-value">@(cantidadVentasHoy > 0 ? (ventasHoy / cantidadVentasHoy).ToString("C") : "$0")</div>
                <div class="stat-sub">Por transacción</div>
            </div>
        </div>

        <!-- Mensaje Motivacional -->
        <div class="motivational-card">
            <p>
                <i class="bi bi-chat-quote-fill" style="color: #667eea; margin-right: 10px;"></i>
                @{
                    string mensajeDia = "";
                    switch (fechaActual.DayOfWeek)
                    {
                        case DayOfWeek.Monday:
                            mensajeDia = "💪 ¡Nueva semana, nuevas oportunidades! Mucho éxito en tus ventas hoy.";
                            break;
                        case DayOfWeek.Tuesday:
                            mensajeDia = "🚀 Martes de grandes ventas. Ofrece lo mejor a tus clientes.";
                            break;
                        case DayOfWeek.Wednesday:
                            mensajeDia = "⭐ Mitad de semana. ¡Sigue así, vas muy bien!";
                            break;
                        case DayOfWeek.Thursday:
                            mensajeDia = "✨ Jueves de cierre. ¡Un último esfuerzo y a disfrutar el fin de semana!";
                            break;
                        case DayOfWeek.Friday:
                            mensajeDia = "🎉 ¡Viernes! Haz que tus clientes se vayan felices con sus compras.";
                            break;
                        case DayOfWeek.Saturday:
                            mensajeDia = "😊 Sábado de atención especial. ¡Muchas ventas!";
                            break;
                        case DayOfWeek.Sunday:
                            mensajeDia = "🌟 Domingo de servicio excelente. Cierra la semana con broche de oro.";
                            break;
                    }
                }
                @mensajeDia
            </p>
        </div>

        <!-- Acciones Rápidas -->
        <div class="section-title">
            <i class="bi bi-lightning-charge-fill"></i>
            <span>Acciones Rápidas</span>
        </div>
        <div class="actions-grid">
            <a href="@Url.Action("Create", "Venta")" class="action-card">
                <div class="action-icon"><i class="bi bi-cart-plus"></i></div>
                <div class="action-info">
                    <h4>Nueva Venta</h4>
                    <p>Registrar una nueva venta</p>
                </div>
            </a>
            <a href="@Url.Action("Index", "Catalogo")" class="action-card">
                <div class="action-icon"><i class="bi bi-grid-3x3"></i></div>
                <div class="action-info">
                    <h4>Catálogo</h4>
                    <p>Ver productos disponibles</p>
                </div>
            </a>
            <a href="@Url.Action("Index", "Productos")" class="action-card">
                <div class="action-icon"><i class="bi bi-search"></i></div>
                <div class="action-info">
                    <h4>Buscar Producto</h4>
                    <p>Consultar stock y precios</p>
                </div>
            </a>
            <a href="@Url.Action("QR", "Acceso")" class="action-card">
                <div class="action-icon"><i class="bi bi-qr-code"></i></div>
                <div class="action-info">
                    <h4>QR de Acceso</h4>
                    <p>Para dispositivos móviles</p>
                </div>
            </a>
            <a href="@Url.Action("Index", "Venta")" class="action-card">
                <div class="action-icon"><i class="bi bi-clock-history"></i></div>
                <div class="action-info">
                    <h4>Historial</h4>
                    <p>Ventas realizadas</p>
                </div>
            </a>
        </div>

        <!-- Productos Populares -->
        @if (ViewBag.ProductosPopulares != null && ((dynamic)ViewBag.ProductosPopulares).Count > 0)
        {
            <div class="products-card">
                <div class="products-header">
                    <h3><i class="bi bi-trophy-fill" style="color: #ffc107;"></i> Productos Más Vendidos Hoy</h3>
                </div>
                @foreach (var producto in ViewBag.ProductosPopulares)
                {
                    <div class="product-item">
                        <span class="product-name">@producto.Producto</span>
                        <span class="product-qty">@producto.Cantidad vendidos</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="products-card">
                <div class="products-header">
                    <h3><i class="bi bi-info-circle"></i> Sin ventas registradas hoy</h3>
                </div>
                <div class="empty-products">
                    <i class="bi bi-emoji-smile" style="font-size: 3rem; color: #ddd;"></i>
                    <p>¡Comienza con tu primera venta del día!</p>
                    <a href="@Url.Action("Create", "Venta")" class="btn-outline-dark btn-outline" style="display: inline-block; margin-top: 15px;">
                        <i class="bi bi-cart-plus"></i> Nueva Venta
                    </a>
                </div>
            </div>
        }

        <!-- Footer -->
        <div class="footer-actions">
            <a href="@Url.Action("Logout", "Login")" class="btn-outline-light btn-outline">
                <i class="bi bi-box-arrow-left"></i> Cerrar Sesión
            </a>
            <a href="#" onclick="location.reload();" class="btn-outline-light btn-outline">
                <i class="bi bi-arrow-repeat"></i> Actualizar
            </a>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Actualizar hora
        function actualizarHora() {
        const ahora = new Date();
        document.getElementById('horaActual').textContent = ahora.toLocaleTimeString('es-MX');
        }
        setInterval(actualizarHora, 1000);
        actualizarHora();

        // Efecto hover en tarjetas
        document.querySelectorAll('.stat-card, .action-card').forEach(card => {
        card.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-5px)';
        });
        card.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0)';
        });
        });
    </script>
</body>
</html>