@model OpticaClaridad.Models.Cliente

@{
    ViewData["Title"] = "Nuevo Cliente";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h3 class="card-title">
                <i class="bi bi-person-plus-fill"></i> @ViewData["Title"]
            </h3>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nombre" class="form-label required"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Juan Pérez García" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                        <small class="text-muted">Mínimo 3 caracteres, máximo 100</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control" placeholder="Ej: 555-1234" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                        <small class="text-muted">Máximo 20 caracteres</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="ejemplo@email.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                        <small class="text-muted">Formato de email válido</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Direccion" class="form-label"></label>
                        <input asp-for="Direccion" class="form-control" placeholder="Calle, número, colonia, ciudad" />
                        <span asp-validation-for="Direccion" class="text-danger"></span>
                        <small class="text-muted">Máximo 200 caracteres</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FechaRegistro" class="form-label"></label>
                        <input asp-for="FechaRegistro" type="date" class="form-control" />
                        <span asp-validation-for="FechaRegistro" class="text-danger"></span>
                        <small class="text-muted">Fecha de registro del cliente</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Estado</label>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="Activo" checked />
                            <label class="form-check-label" asp-for="Activo">
                                Cliente activo
                            </label>
                        </div>
                        <small class="text-muted">Los clientes inactivos no aparecerán en nuevas ventas</small>
                    </div>
                </div>

                <div class="card mt-4">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">
                            <i class="bi bi-info-circle"></i> Información importante
                        </h6>
                    </div>
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>Los campos marcados con <span class="text-danger">*</span> son obligatorios</li>
                            <li>El cliente se registrará con la fecha actual si no se especifica otra</li>
                            <li>Puedes desactivar un cliente en lugar de eliminarlo para mantener historial</li>
                            <li>Un cliente activo aparecerá en las opciones al crear una nueva venta</li>
                        </ul>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Guardar Cliente
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Establecer fecha actual por defecto
        document.addEventListener('DOMContentLoaded', function() {
            const fechaInput = document.getElementById('FechaRegistro');
            if (!fechaInput.value) {
                const today = new Date().toISOString().split('T')[0];
                fechaInput.value = today;
            }
        });
    </script>
}

<style>
    .required::after {
        content: " *";
        color: red;
    }
</style>