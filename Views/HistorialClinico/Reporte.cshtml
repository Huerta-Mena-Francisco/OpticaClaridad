@model OpticaClaridad.Models.HistorialClinico

@{
    ViewData["Title"] = "Reporte de Examen Visual";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reporte - @Model.Paciente?.Nombre</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        /* Estilos para impresión */
        @@media print {
            body {
                font-size: 12pt;
                background: white !important;
                color: black !important;
            }

            .no-print {
                display: none !important;
            }

            .print-only {
                display: block !important;
            }

            .card {
                border: 1px solid #000 !important;
                page-break-inside: avoid;
            }

            .container {
                width: 100% !important;
                max-width: 100% !important;
                padding: 0 !important;
                margin: 0 !important;
            }

            .btn {
                display: none !important;
            }

            footer {
                position: fixed;
                bottom: 0;
                width: 100%;
            }

            table {
                page-break-inside: avoid;
            }
        }

        /* Tamaño de página A4 */
        @@page {
            size: A4;
            margin: 15mm;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            padding: 20px;
        }

        .header-reporte {
            border-bottom: 3px solid #007bff;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        .titulo-reporte {
            color: #2c3e50;
            font-weight: 700;
        }

        .seccion-titulo {
            background-color: #e9ecef;
            padding: 8px 15px;
            border-left: 4px solid #007bff;
            margin-top: 20px;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .tabla-graduacion {
            font-size: 1.1rem;
        }

        .pl-badge {
            background-color: #6c757d;
            color: white;
            padding: 3px 8px;
            border-radius: 4px;
            font-weight: bold;
            font-size: 0.9rem;
        }

        .esf-badge {
            background-color: #28a745;
            color: white;
            padding: 3px 8px;
            border-radius: 4px;
            font-weight: bold;
            font-size: 0.9rem;
        }

        .firma-area {
            border-top: 1px dashed #ccc;
            margin-top: 50px;
            padding-top: 20px;
        }

        .watermark {
            position: fixed;
            opacity: 0.1;
            font-size: 120px;
            color: #007bff;
            transform: rotate(-45deg);
            top: 40%;
            left: 10%;
            z-index: -1;
        }

        .print-only {
            display: none;
        }
    </style>
</head>
<body>
    <!-- Watermark -->
    <div class="watermark print-only">
        ÓPTICA CLARIDAD
    </div>

    <div class="container mt-4 mb-4">
        <!-- Botones de control -->
        <div class="no-print mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <a href="javascript:history.back()" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Volver
                </a>
                <div>
                    <button onclick="window.print()" class="btn btn-primary me-2">
                        <i class="fas fa-print me-2"></i>Imprimir Reporte
                    </button>
                </div>
            </div>
            <div class="alert alert-info mt-3">
                <i class="fas fa-info-circle me-2"></i>
                Este reporte está optimizado para impresión. Use el botón "Imprimir Reporte" para obtener una versión imprimible.
            </div>
        </div>

        <!-- Reporte -->
        <div class="card border-0">
            <div class="card-body p-4">
                <!-- Encabezado -->
                <div class="header-reporte">
                    <div class="row">
                        <div class="col-2 text-center">
                            <div class="logo-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                 style="width: 100px; height: 100px; margin: 0 auto;">
                                <i class="fas fa-eye fa-3x"></i>
                            </div>
                        </div>
                        <div class="col-8 text-center">
                            <h1 class="titulo-reporte">ÓPTICA CLARIDAD</h1>
                            <p class="mb-1"><strong>Examen de Agudeza Visual y Refracción</strong></p>
                            <p class="mb-1 text-muted">Calle Principal #123, Ciudad</p>
                            <p class="mb-0 text-muted">Tel: (123) 456-7890 | Email: info@opticaclaridad.com</p>
                        </div>
                        <div class="col-2 text-end">
                            <div class="badge bg-secondary p-2">
                                <small>ID: @Model.Id</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Información del paciente y examen -->
                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="seccion-titulo">
                            <i class="fas fa-user me-2"></i>INFORMACIÓN DEL PACIENTE
                        </div>
                        <table class="table table-sm">
                            <tr>
                                <td width="40%"><strong>Nombre:</strong></td>
                                <td>@Model.Paciente?.Nombre</td>
                            </tr>
                            <tr>
                                <td><strong>Fecha Nacimiento:</strong></td>
                                <td>
                                    @if (Model.Paciente?.FechaNacimiento.HasValue == true)
                                    {
                                        @Model.Paciente.FechaNacimiento.Value.ToString("dd/MM/yyyy")
                                        <text> (@Model.Paciente.Edad años)</text>
                                    }
                                    else
                                    {
                                        <text>No especificada</text>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Sexo:</strong></td>
                                <td>@(Model.Paciente?.Sexo ?? "No especificado")</td>
                            </tr>
                            <tr>
                                <td><strong>Teléfono:</strong></td>
                                <td>@(Model.Paciente?.Telefono ?? "No especificado")</td>
                            </tr>
                        </table>
                    </div>

                    <div class="col-md-6">
                        <div class="seccion-titulo">
                            <i class="fas fa-calendar-check me-2"></i>INFORMACIÓN DEL EXAMEN
                        </div>
                        <table class="table table-sm">
                            <tr>
                                <td width="40%"><strong>Fecha Examen:</strong></td>
                                <td>@Model.FechaExamen.ToString("dd/MM/yyyy")</td>
                            </tr>
                            @if (Model.HoraExamen.HasValue)
                            {
                                <tr>
                                    <td><strong>Hora:</strong></td>
                                    <td>@Model.HoraExamen.Value.ToString(@"hh\:mm")</td>
                                </tr>
                            }
                            <tr>
                                <td><strong>Optometrista:</strong></td>
                                <td>@Model.Optometrista</td>
                            </tr>
                            <tr>
                                <td><strong>Tipo de Examen:</strong></td>
                                <td>
                                    @Model.TipoExamen
                                    @if (Model.CostoExamen.HasValue && Model.TipoExamen != "Gratis")
                                    {
                                        <text> - @Model.CostoFormateado</text>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Resultados del examen -->
                <div class="mt-4">
                    <div class="seccion-titulo">
                        <i class="fas fa-eye me-2"></i>RESULTADOS DE LA REFRACCIÓN
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered text-center tabla-graduacion">
                            <thead class="table-dark">
                                <tr>
                                    <th width="20%"></th>
                                    <th width="20%">ESFERA</th>
                                    <th width="20%">CILINDRO</th>
                                    <th width="20%">EJE</th>
                                    <th width="20%">AGUDEZA VISUAL</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Ojo Derecho (OD) -->
                                <tr>
                                    <td class="text-start fw-bold">
                                        <i class="fas fa-eye me-2"></i>OJO DERECHO (OD)
                                    </td>
                                    <td class="fw-bold">
                                        @if (Model.EsPlanoOD)
                                        {
                                            <span class="pl-badge">PL</span>
                                            <span class="text-muted small">(Plano)</span>
                                        }
                                        else if (Model.EsferaOD.HasValue)
                                        {
                                            @Model.EsferaOD.Value.ToString("+0.00;-0.00")
                                        }
                                        else
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.CilindroPlanoOD)
                                        {
                                            <span class="esf-badge">ESF</span>
                                            <span class="text-muted small">(Esférico)</span>
                                        }
                                        else if (Model.CilindroOD.HasValue && Model.CilindroOD.Value != 0)
                                        {
                                            @Model.CilindroOD.Value.ToString("+0.00;-0.00")
                                        }
                                        else
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.EjeOD.HasValue && !Model.CilindroPlanoOD)
                                        {
                                            @Model.EjeOD.Value.ToString()<text>°</text>
                                        }
                                        else
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(Model.AgudezaVisualODLejos))
                                        {
                                            <div><strong>Lejos:</strong> @Model.AgudezaVisualODLejos</div>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.AgudezaVisualODCerca))
                                        {
                                            <div><strong>Cerca:</strong> @Model.AgudezaVisualODCerca</div>
                                        }
                                        @if (string.IsNullOrEmpty(Model.AgudezaVisualODLejos) && string.IsNullOrEmpty(Model.AgudezaVisualODCerca))
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                    </td>
                                </tr>

                                <!-- Ojo Izquierdo (OI) -->
                                <tr>
                                    <td class="text-start fw-bold">
                                        <i class="fas fa-eye me-2"></i>OJO IZQUIERDO (OI)
                                    </td>
                                    <td class="fw-bold">
                                        @if (Model.EsPlanoOI)
                                        {
                                            <span class="pl-badge">PL</span>
                                            <span class="text-muted small">(Plano)</span>
                                        }
                                        else if (Model.EsferaOI.HasValue)
                                        {
                                            @Model.EsferaOI.Value.ToString("+0.00;-0.00")
                                        }
                                        else
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.CilindroPlanoOI)
                                        {
                                            <span class="esf-badge">ESF</span>
                                            <span class="text-muted small">(Esférico)</span>
                                        }
                                        else if (Model.CilindroOI.HasValue && Model.CilindroOI.Value != 0)
                                        {
                                            @Model.CilindroOI.Value.ToString("+0.00;-0.00")
                                        }
                                        else
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.EjeOI.HasValue && !Model.CilindroPlanoOI)
                                        {
                                            @Model.EjeOI.Value.ToString()<text>°</text>
                                        }
                                        else
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(Model.AgudezaVisualOILejos))
                                        {
                                            <div><strong>Lejos:</strong> @Model.AgudezaVisualOILejos</div>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.AgudezaVisualOICerca))
                                        {
                                            <div><strong>Cerca:</strong> @Model.AgudezaVisualOICerca</div>
                                        }
                                        @if (string.IsNullOrEmpty(Model.AgudezaVisualOILejos) && string.IsNullOrEmpty(Model.AgudezaVisualOICerca))
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Leyenda de PL y ESF -->
                    <div class="small text-muted mt-2 text-end">
                        <span class="pl-badge me-1">PL</span> = Plano (sin graduación) | 
                        <span class="esf-badge me-1">ESF</span> = Esférico (sin componente cilíndrico)
                    </div>
                </div>

                <!-- Datos adicionales -->
                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="seccion-titulo">
                            <i class="fas fa-ruler-combined me-2"></i>DATOS ADICIONALES
                        </div>
                        <table class="table table-sm">
                            <tr>
                                <td width="50%"><strong>Adición (Add):</strong></td>
                                <td>
                                    @if (Model.Adicion.HasValue)
                                    {
                                        <span class="badge bg-primary">+@Model.Adicion.Value.ToString("0.00")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No aplica</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Distancia Pupilar (DP):</strong></td>
                                <td>
                                    @if (Model.DistanciaPupilar.HasValue)
                                    {
                                        @Model.DistanciaPupilar.Value.ToString("0.0") <text>mm</text>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No medida</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Tipo de Lente Sugerido:</strong></td>
                                <td>
                                    <span class="badge bg-dark">@Model.TipoLenteSugerido</span>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Graduación Formateada:</strong></td>
                                <td>
                                    <small>OD: @Model.GraduacionODFormateada</small><br />
                                    <small>OI: @Model.GraduacionOIFormateada</small>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div class="col-md-6">
                        <div class="seccion-titulo">
                            <i class="fas fa-clipboard-list me-2"></i>ANTECEDENTES MÉDICOS
                        </div>
                        <div class="small">
                            @{
                                var antecedentes = new List<string>();
                                if (Model.TieneDiabetes) antecedentes.Add("Diabetes");
                                if (Model.TieneHipertension) antecedentes.Add("Hipertensión");
                                if (Model.TieneAlergias) antecedentes.Add("Alergias");

                                if (antecedentes.Any())
                                {
                                    <p><strong>Patologías:</strong> @string.Join(", ", antecedentes)</p>

                                    if (Model.TieneDiabetes && !string.IsNullOrEmpty(Model.DiabetesTratamiento))
                                    {
                                        <p><small><strong>Tratamiento Diabetes:</strong> @Model.DiabetesTratamiento</small></p>
                                    }

                                    if (Model.TieneHipertension && !string.IsNullOrEmpty(Model.HipertensionTratamiento))
                                    {
                                        <p><small><strong>Tratamiento Hipertensión:</strong> @Model.HipertensionTratamiento</small></p>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted">Sin antecedentes médicos registrados</p>
                                }
                            }

                            @if (Model.UsaLentes)
                            {
                                <p><strong>Usa lentes actualmente:</strong> Sí</p>
                                @if (!string.IsNullOrEmpty(Model.TipoLentesActuales))
                                {
                                    <p><small><strong>Tipo actual:</strong> @Model.TipoLentesActuales</small></p>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Observaciones y recomendaciones -->
                <div class="mt-4">
                    <div class="seccion-titulo">
                        <i class="fas fa-sticky-note me-2"></i>OBSERVACIONES Y RECOMENDACIONES
                    </div>

                    <div class="row">
                        @if (!string.IsNullOrEmpty(Model.ObservacionesExamen))
                        {
                            <div class="col-md-6">
                                <div class="card border-light">
                                    <div class="card-header bg-light">
                                        <strong>Observaciones del Examen:</strong>
                                    </div>
                                    <div class="card-body">
                                        @Model.ObservacionesExamen
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Recomendaciones))
                        {
                            <div class="col-md-6">
                                <div class="card border-light">
                                    <div class="card-header bg-light">
                                        <strong>Recomendaciones:</strong>
                                    </div>
                                    <div class="card-body">
                                        @Model.Recomendaciones
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (string.IsNullOrEmpty(Model.ObservacionesExamen) && string.IsNullOrEmpty(Model.Recomendaciones))
                    {
                        <p class="text-muted text-center mt-3">No hay observaciones ni recomendaciones registradas.</p>
                    }
                </div>

                <!-- Seguimiento -->
                <div class="row mt-4">
                    @if (Model.NecesitaSeguimiento)
                    {
                        <div class="col-md-6">
                            <div class="alert alert-warning">
                                <h6><i class="fas fa-calendar-check me-2"></i>SEGUIMIENTO REQUERIDO</h6>
                                @if (Model.FechaProximoControl.HasValue)
                                {
                                    <p class="mb-0"><strong>Próximo control:</strong> @Model.FechaProximoControl.Value.ToString("dd/MM/yyyy")</p>
                                }
                                else
                                {
                                    <p class="mb-0">Se recomienda control de seguimiento</p>
                                }
                            </div>
                        </div>
                    }

                    @if (Model.InteresEnCompra)
                    {
                        <div class="col-md-6">
                            <div class="alert alert-info">
                                <h6><i class="fas fa-shopping-cart me-2"></i>INTERÉS EN COMPRA</h6>
                                @if (!string.IsNullOrEmpty(Model.ObservacionesInteres))
                                {
                                    <p class="mb-0">@Model.ObservacionesInteres</p>
                                }
                                else
                                {
                                    <p class="mb-0">El paciente mostró interés en adquirir lentes</p>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Firmas -->
                <div class="firma-area mt-5">
                    <div class="row">
                        <div class="col-md-6 text-center">
                            <div style="border-top: 1px solid #000; width: 70%; margin: 20px auto 0;">
                                <p class="mb-0 mt-2">Firma del Optometrista</p>
                                <p class="text-muted small">@Model.Optometrista</p>
                            </div>
                        </div>
                        <div class="col-md-6 text-center">
                            <div style="border-top: 1px solid #000; width: 70%; margin: 20px auto 0;">
                                <p class="mb-0 mt-2">Firma del Paciente</p>
                                <p class="text-muted small">@Model.Paciente?.Nombre</p>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <p class="text-muted small">
                            <i class="fas fa-info-circle me-1"></i>
                            Reporte generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm") |
                            Óptica Claridad © @DateTime.Now.Year
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mensaje para impresión -->
        <div class="alert alert-secondary print-only mt-4">
            <p class="mb-0 text-center">
                <strong>Este es un documento oficial de Óptica Claridad</strong><br>
                Conserve este documento para futuras referencias y controles
            </p>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const printBtn = document.querySelector('button[onclick="window.print()"]');
            if (printBtn) {
                printBtn.addEventListener('click', function() {
                    setTimeout(function() {
                        window.print();
                    }, 100);
                });
            }
        });
    </script>
</body>
</html>