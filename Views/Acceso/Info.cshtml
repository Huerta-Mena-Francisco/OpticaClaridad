@{
    ViewData["Title"] = "Óptica Claridad";
    Layout = null; // Sin layout para móviles
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.AppName - Acceso Móvil</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .app-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-top: 20px;
        }

        .app-header {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            color: white;
            padding: 30px 20px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="app-card">
                    <div class="app-header">
                        <h1><i class="bi bi-eyeglasses"></i></h1>
                        <h2>Óptica Claridad</h2>
                        <p class="mb-0">Sistema de Gestión</p>
                    </div>

                    <div class="p-4 text-center">
                        <h4 class="mb-4">📱 Acceso desde Móvil</h4>

                        <div class="alert alert-success mb-4">
                            <i class="bi bi-check-circle"></i>
                            <strong>Enlace automático generado</strong>
                            <p class="mb-0 mt-2">Serás redirigido en 3 segundos...</p>
                        </div>

                        <a href="@ViewBag.AppUrl" class="btn btn-primary btn-lg w-100 mb-3">
                            <i class="bi bi-box-arrow-in-right"></i>
                            Abrir Aplicación Ahora
                        </a>

                        <div class="text-muted mt-4">
                            <small>
                                <i class="bi bi-info-circle"></i>
                                Si no se abre automáticamente, haz clic en el botón superior
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Redireccionar automáticamente después de 3 segundos
        setTimeout(function() {
            window.location.href = '@ViewBag.AppUrl';
        }, 3000);
    </script>
</body>
</html>