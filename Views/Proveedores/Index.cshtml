@model IEnumerable<OpticaClaridad.Models.Proveedor>

@{
    ViewData["Title"] = "Proveedores";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-truck"></i> @ViewData["Title"]</h1>
        <a asp-action="Crear" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nuevo Proveedor
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Contacto</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var proveedor in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@proveedor.Nombre</strong>
                                        @if (!string.IsNullOrEmpty(proveedor.Direccion))
                                        {
                                            <br>
                                
                                            <small class="text-muted">@proveedor.Direccion</small>
                                        }
                                    </td>
                                    <td>@proveedor.Contacto</td>
                                    <td>@proveedor.Telefono</td>
                                    <td>@proveedor.Email</td>
                                    <td>
                                        @if (proveedor.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Editar" asp-route-id="@proveedor.Id"
                                               class="btn btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Detalles" asp-route-id="@proveedor.Id"
                                               class="btn btn-outline-info" title="Detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (proveedor.Activo)
                                            {
                                                <a asp-action="Eliminar" asp-route-id="@proveedor.Id"
                                                   class="btn btn-outline-danger" title="Desactivar">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="Activar" asp-route-id="@proveedor.Id"
                                                   class="btn btn-outline-success" title="Activar">
                                                    <i class="bi bi-check-circle"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-truck display-1 text-muted mb-3"></i>
                    <h4 class="text-muted">No hay proveedores registrados</h4>
                    <p class="text-muted">Comienza agregando el primer proveedor</p>
                    <a asp-action="Crear" class="btn btn-primary mt-3">
                        <i class="bi bi-plus-circle"></i> Agregar Proveedor
                    </a>
                </div>
            }
        </div>
    </div>
</div>