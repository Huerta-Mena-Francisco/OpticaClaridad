@model OpticaClaridad.Models.Proveedor

@{
    ViewData["Title"] = "Desactivar Proveedor";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Proveedores</a></li>
            <li class="breadcrumb-item active">Desactivar</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4><i class="bi bi-exclamation-triangle"></i> @ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <h5 class="text-danger mb-4">¿Está seguro que desea desactivar este proveedor?</h5>

                    <dl class="row">
                        <dt class="col-sm-4">Nombre:</dt>
                        <dd class="col-sm-8">@Model.Nombre</dd>

                        <dt class="col-sm-4">Contacto:</dt>
                        <dd class="col-sm-8">@Model.Contacto</dd>

                        <dt class="col-sm-4">Teléfono:</dt>
                        <dd class="col-sm-8">@Model.Telefono</dd>

                        <dt class="col-sm-4">Email:</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Estado:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </dd>
                    </dl>

                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle"></i> El proveedor será marcado como inactivo y no aparecerá en las listas de selección.
                    </div>

                    <form asp-action="Eliminar">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Sí, Desactivar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>