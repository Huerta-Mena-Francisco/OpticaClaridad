@model OpticaClaridad.Models.Proveedor

@{
    ViewData["Title"] = "Detalles del Proveedor";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Proveedores</a></li>
            <li class="breadcrumb-item active">Detalles</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4><i class="bi bi-info-circle"></i> @ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Nombre:</dt>
                        <dd class="col-sm-9">@Model.Nombre</dd>

                        <dt class="col-sm-3">Contacto:</dt>
                        <dd class="col-sm-9">@Model.Contacto</dd>

                        <dt class="col-sm-3">Teléfono:</dt>
                        <dd class="col-sm-9">@Model.Telefono</dd>

                        <dt class="col-sm-3">Email:</dt>
                        <dd class="col-sm-9">@Model.Email</dd>

                        <dt class="col-sm-3">Dirección:</dt>
                        <dd class="col-sm-9">@Model.Direccion</dd>

                        <dt class="col-sm-3">Notas:</dt>
                        <dd class="col-sm-9">@Model.Notas</dd>

                        <dt class="col-sm-3">Estado:</dt>
                        <dd class="col-sm-9">
                            @if (Model.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Registro:</dt>
                        <dd class="col-sm-9">@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>
                    </dl>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Volver</a>
                        <div>
                            <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            @if (Model.Activo)
                            {
                                <a asp-action="Eliminar" asp-route-id="@Model.Id" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Desactivar
                                </a>
                            }
                            else
                            {
                                <a asp-action="Activar" asp-route-id="@Model.Id" class="btn btn-success">
                                    <i class="bi bi-check-circle"></i> Activar
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>