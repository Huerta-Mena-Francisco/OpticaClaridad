@model OpticaClaridad.Models.AbonoCredito
@{
    ViewData["Title"] = "Registrar Abono";
    var credito = ViewBag.Credito as OpticaClaridad.Models.Credito;
    var saldoPendiente = ViewBag.SaldoPendiente as decimal?;
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h3 class="card-title">
                <i class="bi bi-cash-coin"></i> @ViewData["Title"]
            </h3>
        </div>
        <div class="card-body">
            <!-- Información del crédito -->
            @if (credito != null)
            {
                <div class="alert alert-info mb-4">
                    <h6 class="alert-heading">
                        <i class="bi bi-credit-card"></i> Información del Crédito
                    </h6>
                    <div class="row">
                        <div class="col-md-3">
                            <small class="text-muted">Paciente:</small><br />  <!-- 🔴 CAMBIO: Paciente -->
                            <strong>@credito.Paciente?.Nombre</strong>  <!-- 🔴 CAMBIO: Paciente en lugar de Cliente -->
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Monto Total:</small><br />
                            <strong>@credito.MontoTotal.ToString("C")</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Saldo Pendiente:</small><br />
                            <strong class="text-danger">@ViewBag.SaldoPendiente?.ToString("C")</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">% Pagado:</small><br />
                            <strong>@credito.PorcentajePagado.ToString("N1")%</strong>
                        </div>
                    </div>
                </div>
            }

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- Campo oculto para CreditoId -->
                <input type="hidden" asp-for="CreditoId" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FechaAbono" class="form-label required"></label>
                        <input asp-for="FechaAbono" type="date" class="form-control" required />
                        <span asp-validation-for="FechaAbono" class="text-danger"></span>
                        <small class="text-muted">Fecha en que se realiza el abono</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Monto" class="form-label required"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Monto" class="form-control"
                                   placeholder="0.00" step="0.01" min="0.01"
                                   max="@saldoPendiente" required
                                   id="montoInput" />
                        </div>
                        <span asp-validation-for="Monto" class="text-danger"></span>
                        <small class="text-muted">
                            Máximo permitido: <span id="maxMonto" class="fw-bold">@saldoPendiente?.ToString("C")</span>
                            <button type="button" class="btn btn-sm btn-outline-primary ms-2"
                                    onclick="document.getElementById('montoInput').value = @(saldoPendiente?.ToString("0.00").Replace(",", ".") ?? "0")">
                                <i class="bi bi-check-all"></i> Pago completo
                            </button>
                        </small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label asp-for="Observaciones" class="form-label"></label>
                        <textarea asp-for="Observaciones" class="form-control" rows="3"
                                  placeholder="Forma de pago, referencia, notas adicionales..."></textarea>
                        <span asp-validation-for="Observaciones" class="text-danger"></span>
                        <small class="text-muted">Máximo 500 caracteres</small>
                    </div>
                </div>

                <!-- Campos ocultos necesarios -->
                <input type="hidden" asp-for="UsuarioId" value="@User.Identity?.Name ?? " SISTEMA"" />

                <!-- Simulación del pago -->
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">
                            <i class="bi bi-calculator"></i> Simulación de Pago
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label">Saldo Anterior:</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="text" class="form-control bg-light"
                                               value="@credito?.Saldo.ToString("N2")" readonly />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label">Monto Abono:</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="text" class="form-control bg-light"
                                               id="simMonto" value="0.00" readonly />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label">Nuevo Saldo:</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="text" class="form-control bg-light"
                                               id="simNuevoSaldo" value="0.00" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning mt-3" id="alertaPagoCompleto" style="display: none;">
                            <i class="bi bi-check-circle"></i>
                            <strong>¡PAGO COMPLETO!</strong> Este abono liquidará el crédito por completo.
                        </div>
                    </div>
                </div>

                <!-- Botones -->
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" asp-route-creditoId="@Model.CreditoId"
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Registrar Abono
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const montoInput = document.getElementById('montoInput');
            const saldoPendiente = @(ViewBag.SaldoPendiente?.ToString("0.00").Replace(",", ".") ?? "0");
            const fechaAbonoInput = document.getElementById('FechaAbono');
            const simMonto = document.getElementById('simMonto');
            const simNuevoSaldo = document.getElementById('simNuevoSaldo');
            const alertaPagoCompleto = document.getElementById('alertaPagoCompleto');

            // Establecer fecha actual por defecto
            if (!fechaAbonoInput.value) {
                const today = new Date().toISOString().split('T')[0];
                fechaAbonoInput.value = today;
            }

            // Actualizar simulación
            function actualizarSimulacion() {
                const monto = parseFloat(montoInput.value) || 0;
                const nuevoSaldo = saldoPendiente - monto;

                simMonto.value = monto.toFixed(2);
                simNuevoSaldo.value = nuevoSaldo.toFixed(2);

                // Mostrar/ocultar alerta de pago completo
                if (nuevoSaldo <= 0 && monto > 0) {
                    alertaPagoCompleto.style.display = 'block';
                    simNuevoSaldo.classList.remove('bg-light');
                    simNuevoSaldo.classList.add('bg-success', 'text-white');
                } else {
                    alertaPagoCompleto.style.display = 'none';
                    simNuevoSaldo.classList.remove('bg-success', 'text-white');
                    simNuevoSaldo.classList.add('bg-light');
                }

                // Validar que no exceda el saldo
                if (monto > saldoPendiente) {
                    montoInput.classList.add('is-invalid');
                    document.querySelector('[data-valmsg-for="Monto"]').textContent =
                        `El monto no puede exceder el saldo pendiente ($${saldoPendiente.toFixed(2)})`;
                } else {
                    montoInput.classList.remove('is-invalid');
                }
            }

            montoInput.addEventListener('input', actualizarSimulacion);
            montoInput.addEventListener('change', actualizarSimulacion);

            // Inicializar simulación
            actualizarSimulacion();
        });
    </script>
}

<style>
    .required::after {
        content: " *";
        color: red;
    }
</style>