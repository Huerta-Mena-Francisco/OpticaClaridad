@model OpticaClaridad.Models.ReporteTicket
@{
    ViewData["Title"] = "Ticket Histórico de Abonos - Impresión Directa";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ticket Histórico de Abonos</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Courier New', monospace;
        }

        body {
            background: #f5f5f5;
            padding: 20px;
        }

        .ticket-container {
            width: 58mm;
            margin: 0 auto;
            background: white;
            padding: 8px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .ticket-header {
            text-align: center;
            padding-bottom: 8px;
            border-bottom: 1px dashed #000;
            margin-bottom: 10px;
        }

        .optic-name {
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .optic-slogan {
            font-size: 8px;
            color: #666;
        }

        .ticket-title {
            font-size: 10px;
            font-weight: bold;
            text-align: center;
            background: #000;
            color: white;
            padding: 3px;
            margin: 8px 0;
        }

        .info-section {
            margin-bottom: 10px;
            padding-bottom: 8px;
            border-bottom: 1px dashed #ccc;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 3px;
            font-size: 9px;
        }

        .info-label {
            font-weight: bold;
        }

        .progress-container {
            margin-top: 8px;
            padding: 5px;
            background: #f8f9fa;
        }

        .progress-bar {
            height: 8px;
            background: #e9ecef;
            margin-top: 3px;
        }

        .progress-fill {
            height: 100%;
            background: #28a745;
        }

        .abonos-table {
            width: 100%;
            border-collapse: collapse;
            margin: 8px 0;
            font-size: 8px;
        }

        .abonos-table th {
            background: #f0f0f0;
            padding: 3px;
            border: 1px solid #ddd;
            text-align: center;
        }

        .abonos-table td {
            padding: 3px;
            border: 1px solid #ddd;
            text-align: center;
        }

        .totales-section {
            margin-top: 10px;
            padding-top: 8px;
            border-top: 2px dashed #000;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            font-size: 9px;
            margin-bottom: 3px;
            padding: 2px 0;
        }

        .total-amount {
            font-weight: bold;
        }

        .ticket-footer {
            text-align: center;
            margin-top: 10px;
            padding-top: 8px;
            border-top: 1px dashed #ccc;
            font-size: 7px;
        }

        .contact-info {
            margin-top: 5px;
        }

        .screen-only {
            margin-top: 20px;
            text-align: center;
        }

        .btn-ticket {
            font-size: 12px;
            padding: 8px 16px;
            margin: 5px;
        }

        .alert-message {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            display: none;
            min-width: 250px;
        }

        @@media print {
            .screen-only {
                display: none !important;
            }
            .ticket-container {
                box-shadow: none;
                padding: 5px;
                margin: 0;
            }
            body {
                background: white;
                padding: 0;
                margin: 0;
            }
        }
    </style>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
</head>
<body>
    <div class="alert alert-success alert-message" id="alertMessage"></div>

    <div class="ticket-container">
        <!-- CABECERA -->
        <div class="ticket-header">
            <div class="optic-name">OPTICA CLARIDAD</div>
            <div class="optic-slogan">Especialistas en salud visual</div>
            <div class="optic-slogan">Tel: 656 556 3770</div>
        </div>

        <!-- TÍTULO -->
        <div class="ticket-title">HISTORIAL DE ABONOS</div>

        <!-- INFORMACIÓN DEL CRÉDITO -->
        <div class="info-section">
            <div class="info-row">
                <span class="info-label">No. Credito:</span>
                <span>#@Model.Credito.Id</span>
            </div>
            <div class="info-row">
                <span class="info-label">Paciente:</span>
                <span>@(Model.Credito.Paciente?.Nombre?.Length > 20 ? Model.Credito.Paciente.Nombre.Substring(0,20) : Model.Credito.Paciente?.Nombre ?? "Paciente")</span>
            </div>
            <div class="info-row">
                <span class="info-label">Fecha Credito:</span>
                <span>@Model.Credito.FechaCredito.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="info-row">
                <span class="info-label">Vencimiento:</span>
                <span>@(Model.Credito.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "No definida")</span>
            </div>
            <div class="info-row">
                <span class="info-label">Monto Total:</span>
                <span>$@Model.Credito.MontoTotal.ToString("N2")</span>
            </div>
            <div class="info-row">
                <span class="info-label">Saldo:</span>
                <span>$@Model.Credito.Saldo.ToString("N2")</span>
            </div>
            <div class="progress-container">
                <div class="info-row" style="justify-content: space-between;">
                    <small>Progreso:</small>
                    <small>@Model.Credito.PorcentajePagado.ToString("N1")%</small>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: @(Model.Credito.PorcentajePagado > 100 ? 100 : Model.Credito.PorcentajePagado)%"></div>
                </div>
            </div>
        </div>

        <!-- LISTA DE ABONOS -->
        @if (Model.Abonos.Any())
        {
            <div>
                <div style="text-align: center; font-weight: bold; font-size: 9px; margin-bottom: 5px;">
                    DETALLE DE ABONOS
                </div>
                <table class="abonos-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>FECHA</th>
                            <th>MONTO</th>
                        </thead>
                    <tbody>
                        @{
                            int counter = 1;
                        }
                        @foreach (var abono in Model.Abonos)
                        {
                            <tr>
                                <td>@counter</td>
                                <td>@abono.FechaAbono.ToString("dd/MM/yyyy")</td>
                                <td>$@abono.Monto.ToString("N2")</td>
                            </tr>
                            counter++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 10px; color: #666; font-size: 9px;">
                No hay abonos registrados
            </div>
        }

        <!-- TOTALES -->
        <div class="totales-section">
            <div class="total-row">
                <span>Total Abonado:</span>
                <span class="total-amount">$@Model.TotalAbonado.ToString("N2")</span>
            </div>
            <div class="total-row">
                <span>Saldo Pendiente:</span>
                <span class="total-amount">$@Model.Credito.Saldo.ToString("N2")</span>
            </div>
            <div class="total-row">
                <span>% Pagado:</span>
                <span>@Model.Credito.PorcentajePagado.ToString("N1")%</span>
            </div>
        </div>

        <!-- PIE DEL TICKET -->
        <div class="ticket-footer">
            <div class="contact-info">
                <div>¡GRACIAS POR SU PAGO!</div>
                <div>Conserve este comprobante</div>
                <div>--------------------------------</div>
                <div>Generado: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
                <div>ID: @Model.Credito.Id-@DateTime.Now.ToString("HHmmss")</div>
                <div>--------------------------------</div>
                <div>Instagram: @@opticaclaridadjrz</div>
                <div>Facebook: /OpticaClaridad</div>
                <div>wa.me/5216565563770</div>
            </div>
        </div>
    </div>

    <!-- Controles solo visibles en pantalla -->
    <div class="screen-only">
        <div class="d-flex justify-content-center flex-wrap">
            <button type="button" class="btn btn-success btn-ticket" id="btnImprimirDirecto">
                <i class="bi bi-printer"></i> Imprimir Ticket
            </button>
            <button type="button" class="btn btn-primary btn-ticket" id="btnVistaPrevia">
                <i class="bi bi-eye"></i> Vista Previa
            </button>
            <a asp-action="HistorialAbonos" asp-controller="Creditos" asp-route-id="@Model.Credito.Id" class="btn btn-secondary btn-ticket">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>
        <div class="mt-3 text-center text-muted">
            <small><i class="bi bi-info-circle"></i> La impresión se envía directamente a la impresora térmica</small>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            // Función para generar texto plano del ticket
            function generarTextoImpresion() {
                var lineas = [];
                var separador = "--------------------";
                
                lineas.push(separador);
                lineas.push("    OPTICA CLARIDAD");
                lineas.push(" Especialistas en salud");
                lineas.push("       visual");
                lineas.push("Tel: 656 556 3770");
                lineas.push(separador);
                lineas.push("");
                lineas.push("HISTORIAL DE ABONOS");
                lineas.push(separador);
                lineas.push("");
                lineas.push("Credito: #@Model.Credito.Id");
                lineas.push("Paciente: @(Model.Credito.Paciente?.Nombre?.Length > 22 ? Model.Credito.Paciente.Nombre.Substring(0,22) : Model.Credito.Paciente?.Nombre ?? "Paciente")");
                lineas.push("Fecha: @Model.Credito.FechaCredito.ToString("dd/MM/yyyy")");
                lineas.push("Vencimiento: @(Model.Credito.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "No definida")");
                lineas.push("Monto Total: $@Model.Credito.MontoTotal.ToString("N2")");
                lineas.push("Saldo: $@Model.Credito.Saldo.ToString("N2")");
                lineas.push("");
                lineas.push(separador);
                lineas.push("ABONOS REALIZADOS");
                lineas.push(separador);
                
                @if (Model.Abonos.Any())
                {
                    int counter = 1;
                    foreach (var abono in Model.Abonos)
                    {
                        <text>
                        lineas.push("@counter. @abono.FechaAbono.ToString("dd/MM/yyyy") - $@abono.Monto.ToString("N2")");
                        </text>
                        counter++;
                    }
                }
                else
                {
                    <text>lineas.push("No hay abonos registrados");</text>
                }
                
                lineas.push("");
                lineas.push(separador);
                lineas.push("Total Abonado: $@Model.TotalAbonado.ToString("N2")");
                lineas.push("Saldo Pendiente: $@Model.Credito.Saldo.ToString("N2")");
                lineas.push("% Pagado: @Model.Credito.PorcentajePagado.ToString("N1")%");
                lineas.push(separador);
                lineas.push("");
                lineas.push("GRACIAS POR SU PAGO!");
                lineas.push("Conserve este comprobante");
                lineas.push(separador);
                lineas.push("@DateTime.Now.ToString("dd/MM/yyyy HH:mm")");
                lineas.push("Instagram: @@opticaclaridadjrz");
                lineas.push("wa.me/5216565563770");
                lineas.push(separador);
                lineas.push("   VUELVA PRONTO!");
                
                return lineas.join("\n");
            }
            
            function mostrarAlerta(mensaje, tipo) {
                var alertMsg = $('#alertMessage');
                alertMsg.removeClass('alert-success alert-danger alert-info').addClass('alert-' + tipo);
                alertMsg.html(mensaje);
                alertMsg.fadeIn();
                setTimeout(function() { alertMsg.fadeOut(); }, 3000);
            }
            
            function imprimirTicket() {
                var texto = generarTextoImpresion();
                mostrarAlerta('Enviando ticket a impresora...', 'info');
                
                fetch('http://localhost:3001/imprimir', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticket: texto })
                })
                .then(function(response) {
                    if (response.ok) {
                        mostrarAlerta('Ticket enviado correctamente a la impresora', 'success');
                    } else {
                        throw new Error('Error en la impresion');
                    }
                })
                .catch(function(error) {
                    mostrarAlerta('Error: No se pudo conectar al servicio de impresion', 'danger');
                });
            }
            
            $('#btnImprimirDirecto').click(function(e) {
                e.preventDefault();
                imprimirTicket();
            });
            
            $('#btnVistaPrevia').click(function() {
                window.print();
            });
        });
    </script>
    $(document).ready(function() {
    console.log("=== TICKET HISTORICO CARGADO ===");
    console.log("Botón ID: " + $('#btnImprimirDirecto').length);
    
    // Función para generar texto plano del ticket
    function generarTextoImpresion() {
        console.log("Generando texto del ticket...");
        var lineas = [];
        var separador = "--------------------";
        
        lineas.push(separador);
        lineas.push("    OPTICA CLARIDAD");
        lineas.push(" Especialistas en salud");
        lineas.push("       visual");
        lineas.push("Tel: 656 556 3770");
        lineas.push(separador);
        lineas.push("");
        lineas.push("HISTORIAL DE ABONOS");
        lineas.push(separador);
        lineas.push("");
        lineas.push("Credito: #@Model.Credito.Id");
        lineas.push("Paciente: @(Model.Credito.Paciente?.Nombre?.Length > 22 ? Model.Credito.Paciente.Nombre.Substring(0,22) : Model.Credito.Paciente?.Nombre ?? "Paciente")");
        lineas.push("Fecha: @Model.Credito.FechaCredito.ToString("dd/MM/yyyy")");
        lineas.push("Vencimiento: @(Model.Credito.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "No definida")");
        lineas.push("Monto Total: $@Model.Credito.MontoTotal.ToString("N2")");
        lineas.push("Saldo: $@Model.Credito.Saldo.ToString("N2")");
        lineas.push("");
        lineas.push(separador);
        lineas.push("ABONOS REALIZADOS");
        lineas.push(separador);
        
        @if (Model.Abonos.Any())
        {
            int counter = 1;
            foreach (var abono in Model.Abonos)
            {
                <text>
                lineas.push("@counter. @abono.FechaAbono.ToString("dd/MM/yyyy") - $@abono.Monto.ToString("N2")");
                </text>
                counter++;
            }
        }
        else
        {
            <text>lineas.push("No hay abonos registrados");</text>
        }
        
        lineas.push("");
        lineas.push(separador);
        lineas.push("Total Abonado: $@Model.TotalAbonado.ToString("N2")");
        lineas.push("Saldo Pendiente: $@Model.Credito.Saldo.ToString("N2")");
        lineas.push("% Pagado: @Model.Credito.PorcentajePagado.ToString("N1")%");
        lineas.push(separador);
        lineas.push("");
        lineas.push("GRACIAS POR SU PAGO!");
        lineas.push("Conserve este comprobante");
        lineas.push(separador);
        lineas.push("@DateTime.Now.ToString("dd/MM/yyyy HH:mm")");
        lineas.push("Instagram: @@opticaclaridadjrz");
        lineas.push("wa.me/5216565563770");
        lineas.push(separador);
        lineas.push("   VUELVA PRONTO!");
        
        console.log("Texto generado, líneas: " + lineas.length);
        return lineas.join("\n");
    }
    
    function mostrarAlerta(mensaje, tipo) {
        console.log("Alerta: " + mensaje);
        var alertMsg = $('#alertMessage');
        alertMsg.removeClass('alert-success alert-danger alert-info').addClass('alert-' + tipo);
        alertMsg.html(mensaje);
        alertMsg.fadeIn();
        setTimeout(function() { alertMsg.fadeOut(); }, 3000);
    }
    
    function imprimirTicket() {
        console.log("=== FUNCIÓN IMPRIMIR TICKET EJECUTADA ===");
        var texto = generarTextoImpresion();
        console.log("Texto a enviar (primeros 100 chars): " + texto.substring(0, 100));
        mostrarAlerta('Enviando ticket a impresora...', 'info');
        
        fetch('http://localhost:3001/imprimir', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ticket: texto })
        })
        .then(function(response) {
            console.log("Respuesta recibida, status: " + response.status);
            if (response.ok) {
                mostrarAlerta('Ticket enviado correctamente a la impresora', 'success');
            } else {
                throw new Error('Error en la impresion');
            }
        })
        .catch(function(error) {
            console.error("Error en fetch:", error);
            mostrarAlerta('Error: No se pudo conectar al servicio de impresion', 'danger');
        });
    }
    
    // Evento del botón
    $('#btnImprimirDirecto').click(function(e) {
        e.preventDefault();
        console.log("=== BOTÓN IMPRIMIR CLICKEADO ===");
        imprimirTicket();
    });
    
    $('#btnVistaPrevia').click(function() {
        console.log("=== BOTÓN VISTA PREVIA CLICKEADO ===");
        window.print();
    });
    
    console.log("Eventos registrados correctamente");
});

</body>
</html>