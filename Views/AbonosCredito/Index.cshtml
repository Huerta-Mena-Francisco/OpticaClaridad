@model IEnumerable<OpticaClaridad.Models.AbonoCredito>
@{
    ViewData["Title"] = "Historial de Abonos";
    var credito = ViewBag.Credito as OpticaClaridad.Models.Credito;
    var creditoId = ViewBag.CreditoId as int?;
}

<div class="container mt-4">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>
                <i class="bi bi-cash-stack"></i> @ViewData["Title"]
            </h2>
            @if (credito != null)
            {
                <p class="text-muted mb-0">
                    Crédito #@credito.Id - Paciente:
                    <a asp-controller="Pacientes" asp-action="Details" asp-route-id="@credito.PacienteId">
                        <!-- 🔴 CAMBIO: Pacientes en lugar de Clientes -->
                        @credito.Paciente?.Nombre  <!-- 🔴 CAMBIO: Paciente en lugar de Cliente -->
                    </a>
                </p>
            }
        </div>
        <div>
            <a asp-controller="Creditos" asp-action="Details" asp-route-id="@creditoId"
               class="btn btn-info">
                <i class="bi bi-arrow-left"></i> Volver al Crédito
            </a>
            <a asp-action="Create" asp-route-creditoId="@creditoId"
               class="btn btn-success @(credito?.Estado == "PAGADO" ? "disabled" : "")">
                <i class="bi bi-plus-circle"></i> Nuevo Abono
            </a>
        </div>
    </div>

    <!-- Resumen -->
    @if (credito != null)
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-primary">
                    <div class="card-body text-center">
                        <h5 class="card-title">Total Crédito</h5>
                        <h3 class="text-primary">@credito.MontoTotal.ToString("C")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-success">
                    <div class="card-body text-center">
                        <h5 class="card-title">Total Abonado</h5>
                        @{
                            var totalAbonado = Model?.Sum(a => a.Monto) ?? 0;
                        }
                        <h3 class="text-success">@totalAbonado.ToString("C")</h3>
                        <small class="text-muted">@Model?.Count() abono(s)</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-warning">
                    <div class="card-body text-center">
                        <h5 class="card-title">Saldo Pendiente</h5>
                        <h3 class="text-warning">@credito.Saldo.ToString("C")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-info">
                    <div class="card-body text-center">
                        <h5 class="card-title">% Pagado</h5>
                        @{
                            var porcentajePagado = credito.MontoTotal > 0 ? (totalAbonado / credito.MontoTotal) * 100 : 0;
                        }
                        <h3 class="text-info">@porcentajePagado.ToString("N1")%</h3>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Tabla de abonos -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="tablaAbonos">
                    <thead class="table-dark">
                        <tr>
                            <th>Fecha</th>
                            <th>Monto</th>
                            <th>Observaciones</th>
                            <th>Usuario</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.FechaAbono.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="fw-bold text-success">@item.Monto.ToString("C")</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Observaciones))
                                    {
                                        <small>@item.Observaciones</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin observaciones</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@item.UsuarioId</small>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        @if (credito?.Estado != "PAGADO")
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a href="#" data-abono-id="@item.Id"
                                               data-monto="@item.Monto.ToString("C")"
                                               data-fecha="@item.FechaAbono.ToString("dd/MM/yyyy")"
                                               class="btn btn-danger btn-eliminar-abono"
                                               title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-cash display-1 text-muted"></i>
                    <h4 class="mt-3">No hay abonos registrados</h4>
                    <p class="text-muted">
                        Este crédito no tiene abonos registrados aún.
                        @if (credito?.Estado != "PAGADO")
                        {
                            <br />
                            <a asp-action="Create" asp-route-creditoId="@creditoId"
                               class="btn btn-primary mt-3">
                                <i class="bi bi-plus-circle"></i> Registrar Primer Abono
                            </a>
                        }
                    </p>
                </div>
            }

            <!-- Totales -->
            @if (Model.Any())
            {
                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="alert alert-light">
                            <h6 class="mb-2">Resumen de Abonos</h6>
                            <div class="d-flex justify-content-between">
                                <span>Total Abonos:</span>
                                <strong>@Model.Count()</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Suma Total:</span>
                                <strong class="text-success">@Model.Sum(a => a.Monto).ToString("C")</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="alert alert-info">
                            <h6 class="mb-2">Estado del Crédito</h6>
                            <div class="d-flex justify-content-between">
                                <span>Saldo Pendiente:</span>
                                <strong class="@(credito?.Saldo > 0 ? "text-danger" : "text-success")">
                                    @credito?.Saldo.ToString("C")
                                </strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Estado:</span>
                                <span class="badge bg-@(credito?.Estado == "PAGADO" ? "success" : "primary")">
                                    @credito?.Estado
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- DataTables -->
    <script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.3/css/jquery.dataTables.min.css" />

    <script>
        $(document).ready(function() {
            // Inicializar DataTable
            $('#tablaAbonos').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.11.3/i18n/es_es.json"
                },
                "pageLength": 10,
                "order": [[0, "desc"]],
                "responsive": true
            });

            // SweetAlert2 para eliminar abonos
            $('.btn-eliminar-abono').on('click', function(e) {
                e.preventDefault();

                const abonoId = $(this).data('abono-id');
                const monto = $(this).data('monto');
                const fecha = $(this).data('fecha');

                Swal.fire({
                    title: '¿Eliminar este abono?',
                    html: `
                        <div class="text-start">
                            <p>Está a punto de eliminar el siguiente abono:</p>
                            <ul>
                                <li><strong>Fecha:</strong> ${fecha}</li>
                                <li><strong>Monto:</strong> ${monto}</li>
                            </ul>
                            <div class="alert alert-danger mt-3">
                                <i class="bi bi-exclamation-triangle"></i>
                                <strong>Esta acción no se puede deshacer</strong>
                            </div>
                        </div>
                    `,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="bi bi-trash"></i> Sí, eliminar',
                    cancelButtonText: '<i class="bi bi-x-circle"></i> Cancelar',
                    reverseButtons: true,
                    allowOutsideClick: false,
                    showLoaderOnConfirm: true,
                    preConfirm: () => {
                        return fetch(`@Url.Action("Delete", "AbonosCredito")/${abonoId}`, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val(),
                                'Content-Type': 'application/json'
                            }
                        })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Error en la respuesta del servidor');
                            }
                            return response.json();
                        })
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    title: '¡Eliminado!',
                                    text: 'El abono ha sido eliminado correctamente',
                                    icon: 'success',
                                    confirmButtonText: 'Aceptar'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                throw new Error(data.message || 'Error al eliminar');
                            }
                        })
                        .catch(error => {
                            Swal.fire({
                                title: 'Error',
                                text: error.message,
                                icon: 'error',
                                confirmButtonText: 'Aceptar'
                            });
                        });
                    }
                });
            });

            // SweetAlert2 para mensajes de TempData
            @if (TempData["SuccessMessage"] != null)
            {
                        <text>
                        Swal.fire({
                            title: '¡Éxito!',
                            text: '@Html.Raw(TempData["SuccessMessage"])',
                            icon: 'success',
                            confirmButtonText: 'Aceptar'
                        });
                        </text>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                        <text>
                        Swal.fire({
                            title: 'Error',
                            text: '@Html.Raw(TempData["ErrorMessage"])',
                            icon: 'error',
                            confirmButtonText: 'Aceptar'
                        });
                        </text>
            }
        });
    </script>
}