<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Óptica Claridad</title>

    <!-- FAVICON -->
    <link rel="icon" href="~/Optica.jpg" type="image/jpeg" />

    <!-- ✅ BOOTSTRAP CSS (RUTA CORRECTA) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

    <!-- CSS personalizado ORIGINAL - COMPLETO -->
    <style>
        /* ===== TUS ESTILOS ORIGINALES COMPLETOS ===== */
        :root {
            --primary: #6a11cb;
            --secondary: #2575fc;
            --success: #00b894;
            --warning: #fdcb6e;
            --danger: #e17055;
            --info: #00cec9;
            --light: #f8f9fa;
            --dark: #2d3436;
            --sidebar-bg: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: #f8f9fa;
            min-height: 100vh;
        }

        .navbar {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.1);
            padding: 10px 0;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            font-weight: 700;
            font-size: 1.3rem;
        }

        .logo-navbar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(255, 255, 255, 0.8);
            margin-right: 12px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
        }

        .sidebar {
            background: var(--sidebar-bg);
            color: white;
            min-height: calc(100vh - 70px);
            padding-top: 20px;
            position: sticky;
            top: 70px;
            box-shadow: 3px 0 15px rgba(0, 0, 0, 0.1);
        }

            .sidebar a {
                color: rgba(255, 255, 255, 0.8);
                padding: 12px 20px;
                display: block;
                text-decoration: none;
                border-left: 4px solid transparent;
                transition: all 0.3s;
                margin: 3px 10px;
                border-radius: 8px;
            }

                .sidebar a:hover {
                    background: rgba(255, 255, 255, 0.1);
                    color: white;
                    border-left: 4px solid var(--primary);
                }

                .sidebar a.active {
                    background: rgba(255, 255, 255, 0.15);
                    color: white;
                    border-left: 4px solid var(--primary);
                    font-weight: 600;
                }

                .sidebar a i {
                    width: 24px;
                    text-align: center;
                    margin-right: 10px;
                    font-size: 1.1rem;
                }

        .sidebar-section {
            margin-top: 20px;
            margin-bottom: 10px;
            padding: 0 20px;
        }

            .sidebar-section small {
                font-size: 0.75rem;
                letter-spacing: 0.5px;
            }

        .main-content {
            padding: 25px;
            min-height: calc(100vh - 70px);
            background: #f8f9fa;
        }

        .user-info {
            display: flex;
            align-items: center;
            color: white;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: white;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-right: 10px;
            font-size: 0.9rem;
        }

        @@media (max-width: 768px) {
            .sidebar {
                min-height: auto;
                position: static;
            }

            .main-content {
                padding: 15px;
            }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Navbar Superior ORIGINAL -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/Optica.jpg" alt="Óptica Claridad" class="logo-navbar" />
                Óptica Claridad
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door"></i> Inicio
                        </a>
                    </li>
                </ul>

                <div class="user-info">
                    <div class="user-avatar">
                        @{
                            var nombre = Context.Session.GetString("NombreCompleto")?.FirstOrDefault() ?? 'U';
                        }
                        @nombre
                    </div>
                    <div class="d-none d-md-block">
                        <div class="small">@Context.Session.GetString("NombreCompleto")</div>
                        <div class="badge @(Context.Session.GetString("EsAdmin") == "True" ? "bg-warning" : "bg-info")">
                            @(Context.Session.GetString("EsAdmin") == "True" ? "Admin" : "Vendedor")
                        </div>
                    </div>
                    <a asp-controller="Login" asp-action="Logout" class="nav-link text-white ms-3">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Contenedor Principal -->
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar ORIGINAL (solo Admin) -->
            @if (Context.Session.GetString("EsAdmin") == "True")
            {
                <div class="col-lg-2 col-md-3 sidebar d-none d-md-block">
                    <!-- Dashboard Principal -->
                    <a asp-controller="Home" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>

                    <!-- SECCIÓN: OPERACIONES -->
                    <div class="sidebar-section">
                        <small class="text-uppercase opacity-50">Operaciones</small>
                    </div>

                    <a asp-controller="Venta" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Venta" ? "active" : "")">
                        <i class="bi bi-cart me-2"></i> Ventas
                    </a>

                    <a asp-controller="Catalogo" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Catalogo" ? "active" : "")">
                        <i class="bi bi-shop"></i> Catálogo
                    </a>

                    <a asp-controller="Creditos" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Creditos" ? "active" : "")">
                        <i class="bi bi-credit-card"></i> Créditos
                    </a>

                    <a asp-controller="Citas" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Citas" ? "active" : "")">
                        <i class="bi bi-calendar-check"></i> Citas
                    </a>

                    <!-- SECCIÓN: GESTIÓN -->
                    <div class="sidebar-section">
                        <small class="text-uppercase opacity-50">Gestión</small>
                    </div>

                   <a asp-controller="Pacientes" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Pacientes" ? "active" : "")">
                        <i class="bi bi-person-badge"></i> Pacientes
                    </a>

                    <a asp-controller="Productos" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Productos" ? "active" : "")">
                        <i class="bi bi-box"></i> Productos
                    </a>

                    <a asp-controller="Categorias" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categorias" ? "active" : "")">
                        <i class="bi bi-tags"></i> Categorías
                    </a>

                    <a asp-controller="Proveedores" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Proveedores" ? "active" : "")">
                        <i class="bi bi-truck"></i> Proveedores
                    </a>

                    <!-- SECCIÓN: REPORTES -->
                    <div class="sidebar-section">
                        <small class="text-uppercase opacity-50">Reportes</small>
                    </div>

                    <a asp-controller="Reportes" asp-action="Dashboard"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reportes" && ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="bi bi-graph-up"></i> Dashboard Reportes
                    </a>

                    <a asp-controller="Reportes" asp-action="Inventario"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reportes" && ViewContext.RouteData.Values["Action"]?.ToString() == "Inventario" ? "active" : "")">
                        <i class="bi bi-clipboard-data"></i> Estado de Inventario
                    </a>

                    <a asp-controller="Reportes" asp-action="VentasDetallada"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reportes" && ViewContext.RouteData.Values["Action"]?.ToString() == "VentasDetallada" ? "active" : "")">
                        <i class="bi bi-receipt"></i> Ventas Detalladas
                    </a>

                    <!-- SECCIÓN: SISTEMA -->
                    <div class="sidebar-section">
                        <small class="text-uppercase opacity-50">Sistema</small>
                    </div>

                    @if (Context.Session.GetString("EsAdmin") == "True")
                    {
                        <a asp-controller="Usuarios" asp-action="Index"
                           class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Usuarios" ? "active" : "")">
                            <i class="bi bi-person-gear"></i> Usuarios
                        </a>
                    }

                    <a asp-controller="Acceso" asp-action="QR"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Acceso" ? "active" : "")">
                        <i class="bi bi-qr-code"></i> QR de Acceso
                    </a>

                    <a asp-controller="Backup" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Backup" ? "active" : "")">
                        <i class="bi bi-database"></i> Backup BD
                    </a>
                </div>
            }

            <!-- Contenido Principal ORIGINAL -->
            <div class="@(Context.Session.GetString("EsAdmin") == "True" ? "col-lg-10 col-md-9" : "col-12") main-content">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <!-- Scripts - RUTAS CORREGIDAS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>