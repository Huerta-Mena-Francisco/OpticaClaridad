@model IEnumerable<OpticaClaridad.Models.UsuarioSimple>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-people"></i> @ViewData["Title"]</h1>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-person-plus"></i> Nuevo Usuario
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Usuario</th>
                                <th>Nombre Completo</th>
                                <th>Rol</th>
                                <th>Estado</th>
                                <th>Registro</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usuario in Model)
                            {
                                <tr>
                                    <td>@usuario.Id</td>
                                    <td>
                                        <strong>@usuario.NombreUsuario</strong>
                                    </td>
                                    <td>@usuario.NombreCompleto</td>
                                    <td>
                                        @if (usuario.EsAdmin)
                                        {
                                            <span class="badge bg-primary">Administrador</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Vendedor</span>
                                        }
                                    </td>
                                    <td>
                                        @if (usuario.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactivo</span>
                                        }
                                    </td>
                                    <td>@usuario.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit" asp-route-id="@usuario.Id"
                                               class="btn btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (usuario.Activo)
                                            {
                                                <a asp-action="Delete" asp-route-id="@usuario.Id"
                                                   class="btn btn-outline-danger" title="Desactivar">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="Activar" asp-route-id="@usuario.Id"
                                                   class="btn btn-outline-success" title="Activar">
                                                    <i class="bi bi-check-circle"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people display-1 text-muted mb-3"></i>
                    <h4 class="text-muted">No hay usuarios registrados</h4>
                    <p class="text-muted">Comienza agregando el primer usuario</p>
                    <a asp-action="Create" class="btn btn-primary mt-3">
                        <i class="bi bi-person-plus"></i> Crear Primer Usuario
                    </a>
                </div>
            }
        </div>
    </div>
</div>      