@{
    ViewData["Title"] = "Inicio de Sesión";
    Layout = null; // Sin layout para login
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Óptica Claridad - Login</title>

    <!-- FAVICON - Logo en pestaña del navegador -->
    <link rel="icon" href="~/Optica.jpg" type="image/jpeg" />

    <!-- Bootstrap 5 CSS (minificado) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
        /* MANTENIENDO BASE LIGERA */
        body {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 20px;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 40px 35px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.2);
            animation: fadeIn 0.6s ease-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .logo-login {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid white;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            margin: 0 auto 25px;
            display: block;
        }

        .login-title {
            text-align: center;
            color: #333;
            font-weight: 700;
            margin-bottom: 5px;
            font-size: 1.8rem;
        }

        .login-subtitle {
            text-align: center;
            color: #666;
            margin-bottom: 30px;
            font-size: 0.95rem;
        }

        .form-label {
            font-weight: 600;
            color: #444;
            margin-bottom: 8px;
            font-size: 0.9rem;
        }

        .form-control {
            border-radius: 12px;
            padding: 14px 18px;
            border: 2px solid #e1e5e9;
            transition: all 0.3s;
            font-size: 16px; /* Evita zoom en móviles */
        }

            .form-control:focus {
                border-color: #6a11cb;
                box-shadow: 0 0 0 0.25rem rgba(106, 17, 203, 0.15);
            }

        .dropdown-usuario {
            position: relative;
        }

        .dropdown-toggle {
            background: white;
            border: 2px solid #e1e5e9;
            color: #333;
            text-align: left;
            padding: 14px 18px;
            border-radius: 12px;
            width: 100%;
            transition: all 0.3s;
        }

            .dropdown-toggle:hover {
                border-color: #6a11cb;
            }

        .dropdown-menu {
            border-radius: 12px;
            border: 2px solid #e1e5e9;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            max-height: 300px;
            overflow-y: auto;
        }

        .dropdown-item {
            padding: 12px 18px;
            border-bottom: 1px solid #f5f5f5;
            transition: background 0.2s;
        }

            .dropdown-item:hover {
                background: #f8f9fa;
                color: #6a11cb;
            }

        .btn-login {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            border: none;
            color: white;
            padding: 16px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 1.05rem;
            width: 100%;
            transition: transform 0.3s, box-shadow 0.3s;
            margin-top: 10px;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(106, 17, 203, 0.2);
                color: white;
            }

        .alert-error {
            background: #fee;
            border: 2px solid #fcc;
            color: #c33;
            border-radius: 12px;
            padding: 15px;
            margin-top: 20px;
            animation: shake 0.5s;
        }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-5px);
            }

            75% {
                transform: translateX(5px);
            }
        }

        /* Responsive */
        @@media (max-width: 576px) {
            .login-card {
                padding: 30px 25px;
                margin: 10px;
            }

            .logo-login {
                width: 100px;
                height: 100px;
            }
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center">
            <img src="~/Optica.jpg" alt="Óptica Claridad" class="logo-login" />
            <h1 class="login-title">Óptica Claridad</h1>
            <p class="login-subtitle">Sistema de Gestión</p>
        </div>

        <form method="post" asp-action="Index" asp-controller="Login">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label class="form-label">Seleccionar Usuario</label>
                <div class="dropdown dropdown-usuario">
                    <button class="btn btn-outline-secondary dropdown-toggle form-control text-start"
                            type="button"
                            id="dropdownUsuario"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <span id="selectedUser">Seleccione un usuario...</span>
                    </button>
                    <input type="hidden" name="nombreUsuario" id="nombreUsuario" required />
                    <ul class="dropdown-menu w-100" aria-labelledby="dropdownUsuario" id="usuariosList">
                        <!-- Los usuarios se cargarán por JavaScript -->
                        <li class="dropdown-item text-muted text-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            Cargando usuarios...
                        </li>
                    </ul>
                </div>
                <div class="form-text">Seleccione su usuario de la lista</div>
            </div>

            <div class="mb-4">
                <label for="clave" class="form-label">Contraseña</label>
                <input type="password"
                       class="form-control"
                       id="clave"
                       name="clave"
                       placeholder="Ingrese su contraseña"
                       required />
                <div class="form-text">Ingrese la contraseña del usuario seleccionado</div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn-login">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión
                </button>
            </div>

            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert-error mt-4">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p class="mb-0">@error.ErrorMessage</p>
                    }
                </div>
            }
        </form>

        <div class="text-center mt-4 pt-3 border-top">
            <p class="text-muted small mb-0">
                <i class="bi bi-info-circle me-1"></i>
                Sistema optimizado para bajos recursos
            </p>
        </div>
    </div>

    <!-- jQuery (ligero) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap JS Bundle (con Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function() {
            // Cargar usuarios desde la API
            $.ajax({
                url: '/Login/GetUsuarios',
                method: 'GET',
                success: function(usuarios) {
                    const $lista = $('#usuariosList');
                    $lista.empty(); // Limpiar loading

                    if (usuarios.length === 0) {
                        $lista.append(
                            '<li class="dropdown-item text-danger text-center">' +
                            '<i class="bi bi-exclamation-triangle me-2"></i>No hay usuarios disponibles' +
                            '</li>'
                        );
                        return;
                    }

                    usuarios.forEach(function(usuario) {
                        const $item = $('<li>');
                        const $link = $('<a class="dropdown-item" href="#">')
                            .html(`
                                <div class="d-flex align-items-center">
                                    <div class="me-3">
                                        <i class="bi bi-person-circle fs-5 ${usuario.esAdmin ? 'text-primary' : 'text-secondary'}"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold">${usuario.nombreCompleto}</div>
                                        <div class="small text-muted">${usuario.nombreUsuario} ${usuario.esAdmin ? '👑' : ''}</div>
                                    </div>
                                </div>
                            `)
                            .data('usuario', usuario);

                        $link.click(function(e) {
                            e.preventDefault();
                            const usuario = $(this).data('usuario');
                            $('#selectedUser').html(`
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-person-circle me-2 ${usuario.esAdmin ? 'text-primary' : 'text-secondary'}"></i>
                                    <div>
                                        <div class="fw-semibold">${usuario.nombreCompleto}</div>
                                        <div class="small text-muted">${usuario.nombreUsuario}</div>
                                    </div>
                                </div>
                            `);
                            $('#nombreUsuario').val(usuario.nombreUsuario);
                            $('#dropdownUsuario').dropdown('toggle');

                            // Enfocar campo de contraseña
                            setTimeout(() => $('#clave').focus(), 100);
                        });

                        $item.append($link);
                        $lista.append($item);
                    });
                },
                error: function() {
                    $('#usuariosList').html(
                        '<li class="dropdown-item text-danger text-center">' +
                        '<i class="bi bi-exclamation-triangle me-2"></i>Error cargando usuarios' +
                        '</li>'
                    );
                }
            });

            // Validar formulario
            $('form').submit(function(e) {
                if (!$('#nombreUsuario').val()) {
                    e.preventDefault();
                    alert('⚠️ Por favor seleccione un usuario de la lista');
                    $('#dropdownUsuario').focus();
                    return false;
                }

                if (!$('#clave').val()) {
                    e.preventDefault();
                    alert('⚠️ Por favor ingrese su contraseña');
                    $('#clave').focus();
                    return false;
                }

                // Mostrar loading en botón
                $('.btn-login').html('<span class="spinner-border spinner-border-sm me-2"></span> Validando...');
                $('.btn-login').prop('disabled', true);
            });

            // Enfocar dropdown al cargar
            setTimeout(() => {
                $('#dropdownUsuario').focus();
            }, 500);
        });
    </script>
</body>
</html>