@model IEnumerable<OpticaClaridad.Models.Cita>

@if (Model.Any())
{
    <div class="list-group">
        @foreach (var cita in Model)
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1">@cita.ClienteNombre</h6>
                        <p class="mb-1">@cita.TipoCita - @cita.Motivo</p>
                        <small class="text-muted">@cita.FechaHora.ToString("hh:mm tt")</small>
                    </div>
                    <div>
                        @if (cita.Estado == "Pendiente")
                        {
                            <span class="badge bg-warning">Pendiente</span>
                        }
                        else if (cita.Estado == "Confirmada")
                        {
                            <span class="badge bg-success">Confirmada</span>
                        }
                        else if (cita.Estado == "Atendida")
                        {
                            <span class="badge bg-info">Atendida</span>
                        }
                        <a href="/Citas/Detalles/@cita.Id" class="btn btn-sm btn-outline-primary ms-2">
                            <i class="bi bi-eye"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted text-center">No hay citas programadas para este día</p>
    <div class="text-center mt-3">
        <a href="/Citas/Crear?fecha=@ViewBag.Fecha.ToString("yyyy-MM-dd")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Programar Cita
        </a>
    </div>
}