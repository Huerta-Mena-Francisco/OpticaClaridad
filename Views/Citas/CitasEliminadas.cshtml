@model IEnumerable<OpticaClaridad.Models.Cita>

@{
    ViewData["Title"] = "Citas Eliminadas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1><i class="bi bi-trash"></i> @ViewData["Title"]</h1>
            <p class="text-muted mb-0">Citas marcadas como eliminadas</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-primary me-2">
                <i class="bi bi-arrow-left"></i> Volver a Citas
            </a>
            <a asp-action="EliminarAntiguas" class="btn btn-warning"
               onclick="return confirm('¿Marcar automáticamente citas antiguas (más de 1 año) como eliminadas?')">
                <i class="bi bi-clock-history"></i> Limpiar Antiguas
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle"></i> @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Cliente</th>
                                <th>Fecha Original</th>
                                <th>Tipo</th>
                                <th>Estado</th>
                                <th>Eliminada el</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in Model)
                            {
                                <tr>
                                    <td>@cita.ClienteNombre</td>
                                    <td>@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@cita.TipoCita</td>
                                    <td>@cita.Estado</td>
                                    <td>@cita.FechaEliminacion?.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Restaurar" asp-route-id="@cita.Id"
                                               class="btn btn-outline-success" title="Restaurar"
                                               onclick="return confirm('¿Restaurar esta cita?')">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </a>
                                            <a asp-action="EliminarPermanente" asp-route-id="@cita.Id"
                                               class="btn btn-outline-danger" title="Eliminar Permanentemente">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Botón para eliminar todas -->
                @if (Model.Any())
                {
                    <div class="mt-4 text-center">
                        <a asp-action="EliminarTodasPermanente"
                           class="btn btn-danger"
                           onclick="return confirm('¿ESTÁ SEGURO? Esta acción eliminará PERMANENTEMENTE todas las citas marcadas como eliminadas. ¡NO SE PUEDE DESHACER!')">
                            <i class="bi bi-trash3"></i> Eliminar Todas Permanentemente
                        </a>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-check-circle display-1 text-success mb-3"></i>
                <h4 class="text-muted">No hay citas eliminadas</h4>
                <p class="text-muted">La papelera de reciclaje está vacía</p>
                <a asp-action="Index" class="btn btn-primary mt-3">
                    <i class="bi bi-arrow-left"></i> Volver a Citas
                </a>
            </div>
        </div>
    }
</div>