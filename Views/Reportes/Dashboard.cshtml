@model OpticaClaridad.Models.ReportesDashboardViewModel
@{
    ViewData["Title"] = "Dashboard de Reportes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0"><i class="bi bi-bar-chart-line me-2"></i> Dashboard de Reportes</h1>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("ExportarDashboardCSV", "Reportes")"
               class="btn btn-success btn-sm"
               target="_blank">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Exportar a CSV
            </a>
            <small class="text-muted ms-2">Actualizado: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="row mb-4">
        <!-- Ventas Hoy -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Ventas Hoy
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.VentasHoy.ToString("C2")</div>
                            <div class="mt-2 mb-0 text-muted text-xs">
                                <span class="text-success mr-2"><i class="bi bi-receipt"></i> @Model.TransaccionesHoy transacciones</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-cash-stack fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ventas Este Mes -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Ventas Este Mes
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.VentasEsteMes.ToString("C2")</div>
                            <div class="mt-2 mb-0 text-muted text-xs">
                                <span class="@Model.ColorVariacion">
                                    <i class="bi bi-arrow-up-right mr-1"></i>@Model.VariacionVentasFormateada vs mes anterior
                                </span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-calendar-check fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ticket Promedio -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Ticket Promedio
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TicketPromedio.ToString("C2")</div>
                            <div class="mt-2 mb-0 text-muted text-xs">
                                <span class="text-info"><i class="bi bi-graph-up"></i> Margen: @Model.MargenGananciaPromedio.ToString("0.0")%</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-ticket-detailed fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inventario -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Estado de Inventario
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.ValorTotalInventario.ToString("C2")</div>
                            <div class="mt-2 mb-0">
                                <span class="badge bg-warning text-dark">Bajo: @Model.ProductosStockBajo</span>
                                <span class="badge bg-danger ms-1">Agotado: @Model.ProductosStockCritico</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-box-seam fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficas y Tablas -->
    <div class="row">
        <!-- Tendencias de Ventas (Últimos 7 días) -->
        <div class="col-xl-8 col-lg-7 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Tendencias de Ventas (Últimos 7 días)</h6>
                </div>
                <div class="card-body">
                    <div class="chart-area">
                        <canvas id="ventasChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Métodos de Pago -->
        <div class="col-xl-4 col-lg-5 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Ventas por Método de Pago</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Método</th>
                                    <th class="text-end">Monto</th>
                                    <th class="text-end">%</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pago in Model.VentasPorMetodoPago)
                                {
                                    <tr>
                                        <td>
                                            @pago.MetodoPago
                                            <small class="text-muted d-block">@pago.Transacciones trans.</small>
                                        </td>
                                        <td class="text-end">@pago.Total.ToString("C2")</td>
                                        <td class="text-end">@pago.Porcentaje.ToString("0.0")%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Segunda fila de gráficas -->
    <div class="row">
        <!-- Ventas por Categoría -->
        <div class="col-xl-6 col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Ventas por Categoría</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Categoría</th>
                                    <th class="text-end">Ventas</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">%</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var categoria in Model.VentasPorCategoria)
                                {
                                    <tr>
                                        <td>@categoria.Categoria</td>
                                        <td class="text-end">@categoria.Total.ToString("C2")</td>
                                        <td class="text-end">@categoria.Cantidad</td>
                                        <td class="text-end">@categoria.Porcentaje.ToString("0.0")%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top 10 Productos -->
        <div class="col-xl-6 col-lg-6 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Top 10 Productos Más Vendidos</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var producto in Model.TopProductosVendidos)
                                {
                                    <tr>
                                        <td>
                                            <strong>@producto.Producto</strong>
                                            <small class="text-muted d-block">@producto.Codigo</small>
                                        </td>
                                        <td class="text-end">@producto.CantidadVendida</td>
                                        <td class="text-end">@producto.TotalVentas.ToString("C2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertas de Inventario -->
    @if (Model.ProductosStockBajo > 0 || Model.ProductosSinMovimiento > 0)
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow mb-4 border-left-danger">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-danger"><i class="bi bi-exclamation-triangle me-2"></i> Alertas</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @if (Model.ProductosStockBajo > 0)
                            {
                                <div class="col-md-6">
                                    <div class="alert alert-warning mb-0">
                                        <i class="bi bi-exclamation-circle me-2"></i>
                                        <strong>@Model.ProductosStockBajo productos</strong> con stock bajo
                                    </div>
                                </div>
                            }
                            @if (Model.ProductosSinMovimiento > 0)
                            {
                                <div class="col-md-6">
                                    <div class="alert alert-info mb-0">
                                        <i class="bi bi-clock-history me-2"></i>
                                        <strong>@Model.ProductosSinMovimiento productos</strong> sin ventas en 30 días
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Gráfico de tendencias
        var ctx = document.getElementById('ventasChart').getContext('2d');
        var ventasChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [@Html.Raw(string.Join(", ", Model.VentasUltimaSemana.Select(v => $"'{v.Dia}'")))],
                datasets: [{
                    label: 'Ventas ($)',
                    data: [@string.Join(", ", Model.VentasUltimaSemana.Select(v => v.Total))],
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    tension: 0.1,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        display: true
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return '$' + value.toLocaleString();
                            }
                        }
                    }
                }
            }
        });

        // Actualizar automáticamente cada 5 minutos
        setTimeout(function() {
            window.location.reload();
        }, 300000); // 5 minutos
    </script>
}