@model IEnumerable<OpticaClaridad.Models.Producto>

@{
    ViewData["Title"] = "Gestión de Productos";
    ViewData["Subtitle"] = "Listado de productos en inventario";
    var imagenDefault = "/Optica.jpg"; // Imagen por defecto en wwwroot
}

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <div>
            <h5 class="mb-0"><i class="bi bi-box-seam"></i> @ViewData["Title"]</h5>
            <p class="text-muted mb-0">@ViewData["Subtitle"]</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Nuevo Producto
            </a>
        </div>
    </div>

    <div class="card-body">
        <!-- Filtros -->
        <form method="get" asp-action="Index" class="mb-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" name="busqueda"
                               placeholder="Buscar por nombre, código, marca..."
                               value="@ViewBag.BusquedaActual">
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="categoriaId" class="form-select">
                        <option value="">Todas las categorías</option>
                        @if (ViewBag.Categorias != null)
                        {
                            foreach (var categoria in ViewBag.Categorias)
                            {
                                <option value="@categoria.Value"
                                        selected="@(ViewBag.CategoriaIdActual?.ToString() == categoria.Value ? "selected" : null)">
                                    @categoria.Text
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel"></i> Filtrar
                    </button>
                </div>
            </div>
        </form>

        @Html.AntiForgeryToken()

        <!-- Información de resultados -->
        <div class="alert alert-light border mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <i class="bi bi-info-circle me-2"></i>
                    <span id="resultadosInfo">
                        @if (Model != null && Model.Any())
                        {
                            <text>Mostrando <strong>@Model.Count()</strong> de <strong>@ViewBag.TotalProductos</strong> productos</text>
                        }
                        else
                        {
                            <text>No se encontraron productos</text>
                        }
                    </span>
                </div>
                <div class="text-end">
                    <small class="text-muted">
                        Página @ViewBag.Page de @ViewBag.TotalPages
                    </small>
                </div>
            </div>
        </div>

        <!-- Tabla de productos -->
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th width="80">Imagen</th>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th>Stock</th>
                            <th>Precio</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var producto in Model)
                        {
                            // Función para obtener la URL de la imagen
                            string ObtenerImagenUrl()
                            {
                                if (!string.IsNullOrEmpty(producto.ImagenPrincipalUrl))
                                {
                                    // Convertir ruta relativa a URL pública
                                    return $"/archivos/{producto.ImagenPrincipalUrl.Replace('\\', '/')}";
                                }
                                
                                // Buscar primera imagen activa
                                var primeraImagen = producto.Imagenes?.FirstOrDefault(i => i.Activa);
                                if (primeraImagen != null && !string.IsNullOrEmpty(primeraImagen.ImagenUrl))
                                {
                                    return $"/archivos/{primeraImagen.ImagenUrl.Replace('\\', '/')}";
                                }
                                
                                return imagenDefault;
                            }
                            
                            var imagenUrl = ObtenerImagenUrl();
                            
                            <tr>
                                <td>
                                    @if (imagenUrl != imagenDefault)
                                    {
                                        <img src="@imagenUrl"
                                             class="img-thumbnail"
                                             style="width: 60px; height: 60px; object-fit: cover;"
                                             alt="@producto.Nombre"
                                             onerror="this.src='@imagenDefault'">
                                    }
                                    else
                                    {
                                        <img src="@imagenDefault"
                                             class="img-thumbnail"
                                             style="width: 60px; height: 60px; object-fit: cover;"
                                             alt="@producto.Nombre">
                                    }
                                </td>
                                <td>
                                    <strong>@producto.Codigo</strong>
                                </td>
                                <td>
                                    <div class="fw-semibold">@producto.Nombre</div>
                                    <small class="text-muted">
                                        @if (!string.IsNullOrEmpty(producto.Marca))
                                        {
                                            @:Marca: @producto.Marca
                                        }
                                        @if (!string.IsNullOrEmpty(producto.Modelo))
                                        {
                                            if (!string.IsNullOrEmpty(producto.Marca))
                                            {
                                                @:•
                                            }
                                            @:Modelo: @producto.Modelo
                                        }
                                    </small>
                                </td>
                                <td>
                                    @if (producto.Categoria != null)
                                    {
                                        <span class="badge bg-secondary">@producto.Categoria.Nombre</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="me-2">@producto.Stock</div>
                                        @if (producto.Stock <= producto.StockMinimo)
                                        {
                                            <span class="badge bg-warning"><i class="bi bi-exclamation-triangle"></i> Bajo</span>
                                        }
                                    </div>
                                    <small class="text-muted">Mín: @producto.StockMinimo</small>
                                </td>
                                <td>
                                    <div class="fw-semibold">@producto.PrecioVenta.ToString("C")</div>
                                    <small class="text-muted">Compra: @producto.PrecioCompra.ToString("C")</small>
                                </td>
                                <td>
                                    @{
                                        var estadoClase = producto.EstadoStock == "AGOTADO" ? "bg-danger" :
                                                          (producto.EstadoStock == "BAJO" ? "bg-warning" : "bg-success");
                                    }
                                    <span class="badge @estadoClase">@producto.EstadoStock</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@producto.Id"
                                           class="btn btn-outline-info" title="Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@producto.Id"
                                           class="btn btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-outline-warning btn-actualizar-stock"
                                                data-product-id="@producto.Id"
                                                data-product-nombre="@producto.Nombre"
                                                data-product-stock="@producto.Stock"
                                                data-product-stock-minimo="@producto.StockMinimo"
                                                title="Actualizar Stock">
                                            <i class="bi bi-box"></i>
                                        </button>
                                        <a asp-action="Delete" asp-route-id="@producto.Id"
                                           class="btn btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginación corregida -->
            @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
            {
                <nav aria-label="Paginación de productos" class="mt-4">
                    <ul class="pagination justify-content-center flex-wrap">
                        @if (ViewBag.Page > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(ViewBag.Page - 1)"
                                   asp-route-busqueda="@ViewBag.BusquedaActual"
                                   asp-route-categoriaId="@ViewBag.CategoriaIdActual"
                                   asp-route-estadoStock="@ViewBag.EstadoStockActual">
                                    <i class="bi bi-chevron-left"></i> Anterior
                                </a>
                            </li>
                        }

                        @{
                            int startPage = Math.Max(1, ViewBag.Page - 4);
                            int endPage = Math.Min(ViewBag.TotalPages, ViewBag.Page + 4);
                            
                            if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-page="1"
                                       asp-route-busqueda="@ViewBag.BusquedaActual"
                                       asp-route-categoriaId="@ViewBag.CategoriaIdActual"
                                       asp-route-estadoStock="@ViewBag.EstadoStockActual">1</a>
                                </li>
                                if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }
                            
                            for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-busqueda="@ViewBag.BusquedaActual"
                                       asp-route-categoriaId="@ViewBag.CategoriaIdActual"
                                       asp-route-estadoStock="@ViewBag.EstadoStockActual">
                                        @i
                                    </a>
                                </li>
                            }
                            
                            if (endPage < ViewBag.TotalPages)
                            {
                                if (endPage < ViewBag.TotalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-page="@ViewBag.TotalPages"
                                       asp-route-busqueda="@ViewBag.BusquedaActual"
                                       asp-route-categoriaId="@ViewBag.CategoriaIdActual"
                                       asp-route-estadoStock="@ViewBag.EstadoStockActual">
                                        @ViewBag.TotalPages
                                    </a>
                                </li>
                            }
                        }

                        @if (ViewBag.Page < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(ViewBag.Page + 1)"
                                   asp-route-busqueda="@ViewBag.BusquedaActual"
                                   asp-route-categoriaId="@ViewBag.CategoriaIdActual"
                                   asp-route-estadoStock="@ViewBag.EstadoStockActual">
                                    Siguiente <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="text-center py-5">
                <div class="mb-4">
                    <i class="bi bi-box text-muted" style="font-size: 4rem;"></i>
                </div>
                <h5 class="text-muted">No hay productos registrados</h5>
                <p class="text-muted">Comienza agregando tu primer producto</p>
                <a asp-action="Create" class="btn btn-success mt-3">
                    <i class="bi bi-plus-circle"></i> Agregar Primer Producto
                </a>
            </div>
        }
    </div>

    <div class="card-footer bg-white">
        <div class="row">
            <div class="col-md-6">
                <small class="text-muted">
                    <i class="bi bi-info-circle"></i>
                    Total: @ViewBag.TotalProductos productos •
                    Página: @ViewBag.Page de @ViewBag.TotalPages
                </small>
            </div>
            <div class="col-md-6 text-end">
                <small class="text-muted">
                    Mostrando @ViewBag.PageSize productos por página
                </small>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PARA ACTUALIZAR STOCK (igual, sin cambios) -->
<div class="modal fade" id="modalActualizarStock" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title">
                    <i class="bi bi-box"></i> Actualizar Stock
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="productoId" value="" />

                <div class="mb-3">
                    <label class="form-label fw-semibold" id="productoNombre"></label>
                </div>

                <div class="mb-3">
                    <label class="form-label">Stock Actual</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light" id="stockActual"></span>
                        <span class="input-group-text bg-light" id="stockMinimo"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Tipo de movimiento</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="tipoMovimiento" id="tipoAgregar" value="agregar" checked>
                        <label class="btn btn-outline-success" for="tipoAgregar">
                            <i class="bi bi-plus-circle"></i> Agregar
                        </label>

                        <input type="radio" class="btn-check" name="tipoMovimiento" id="tipoQuitar" value="quitar">
                        <label class="btn btn-outline-danger" for="tipoQuitar">
                            <i class="bi bi-dash-circle"></i> Quitar
                        </label>

                        <input type="radio" class="btn-check" name="tipoMovimiento" id="tipoFijar" value="fijar">
                        <label class="btn btn-outline-primary" for="tipoFijar">
                            <i class="bi bi-pencil-square"></i> Fijar
                        </label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" id="lblCantidad">Cantidad a agregar</label>
                    <div class="input-group">
                        <button class="btn btn-outline-secondary" type="button" id="btnDecrementar">
                            <i class="bi bi-dash"></i>
                        </button>
                        <input type="number" id="cantidadStock" class="form-control text-center"
                               value="1" min="1" max="1000" step="1">
                        <button class="btn btn-outline-secondary" type="button" id="btnIncrementar">
                            <i class="bi bi-plus"></i>
                        </button>
                    </div>
                    <small class="text-muted" id="nuevoStockPreview"></small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Cancelar
                </button>
                <button type="button" class="btn btn-warning" id="btnGuardarStock">
                    <i class="bi bi-check-circle"></i> Actualizar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Variable para almacenar el modal
        let modalStock;
        let productoSeleccionado = {};

        $(document).ready(function() {
            // Inicializar modal
            modalStock = new bootstrap.Modal(document.getElementById('modalActualizarStock'));

            // Evento para abrir modal al hacer clic en botón de actualizar stock
            document.querySelectorAll('.btn-actualizar-stock').forEach(btn => {
                btn.addEventListener('click', function() {
                    const productId = this.getAttribute('data-product-id');
                    const productNombre = this.getAttribute('data-product-nombre');
                    const productStock = parseInt(this.getAttribute('data-product-stock'));
                    const productStockMinimo = parseInt(this.getAttribute('data-product-stock-minimo'));

                    productoSeleccionado = {
                        id: productId,
                        nombre: productNombre,
                        stock: productStock,
                        stockMinimo: productStockMinimo
                    };

                    // Llenar datos en el modal
                    document.getElementById('productoId').value = productId;
                    document.getElementById('productoNombre').textContent = productNombre;
                    document.getElementById('stockActual').textContent = productStock + ' unidades';
                    document.getElementById('stockMinimo').textContent = 'Mín: ' + productStockMinimo;

                    // Resetear valores
                    document.getElementById('cantidadStock').value = 1;
                    document.getElementById('tipoAgregar').checked = true;
                    actualizarLabelCantidad();
                    actualizarNuevoStock();

                    // Abrir modal
                    modalStock.show();
                });
            });

            // Evento para cambiar tipo de movimiento
            document.querySelectorAll('input[name="tipoMovimiento"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    actualizarLabelCantidad();
                    actualizarNuevoStock();
                });
            });

            // Eventos para cantidad
            document.getElementById('cantidadStock').addEventListener('input', function() {
                validarCantidad();
                actualizarNuevoStock();
            });

            document.getElementById('btnIncrementar').addEventListener('click', function() {
                let input = document.getElementById('cantidadStock');
                input.value = parseInt(input.value) + 1;
                validarCantidad();
                actualizarNuevoStock();
            });

            document.getElementById('btnDecrementar').addEventListener('click', function() {
                let input = document.getElementById('cantidadStock');
                let nuevoValor = parseInt(input.value) - 1;
                if (nuevoValor >= 1) {
                    input.value = nuevoValor;
                    validarCantidad();
                    actualizarNuevoStock();
                }
            });

            // Evento para guardar
            document.getElementById('btnGuardarStock').addEventListener('click', function() {
                actualizarStock();
            });
        });

        function actualizarLabelCantidad() {
            const tipo = document.querySelector('input[name="tipoMovimiento"]:checked').value;
            const lbl = document.getElementById('lblCantidad');

            if (tipo === 'agregar') {
                lbl.textContent = 'Cantidad a agregar';
            } else if (tipo === 'quitar') {
                lbl.textContent = 'Cantidad a quitar';
            } else {
                lbl.textContent = 'Nuevo stock';
            }
        }

        function validarCantidad() {
            let input = document.getElementById('cantidadStock');
            let valor = parseInt(input.value);

            if (isNaN(valor) || valor < 1) {
                input.value = 1;
            } else if (valor > 1000) {
                input.value = 1000;
            }
        }

        function actualizarNuevoStock() {
            const tipo = document.querySelector('input[name="tipoMovimiento"]:checked').value;
            const cantidad = parseInt(document.getElementById('cantidadStock').value) || 0;
            let nuevoStock = productoSeleccionado.stock;

            if (tipo === 'agregar') {
                nuevoStock += cantidad;
            } else if (tipo === 'quitar') {
                nuevoStock = Math.max(0, nuevoStock - cantidad);
            } else {
                nuevoStock = cantidad;
            }

            const preview = document.getElementById('nuevoStockPreview');
            preview.textContent = `Nuevo stock: ${nuevoStock} unidades`;
            preview.className = nuevoStock <= productoSeleccionado.stockMinimo ?
                'text-danger' : 'text-success';
        }

        function actualizarStock() {
            const productoId = document.getElementById('productoId').value;
            const tipo = document.querySelector('input[name="tipoMovimiento"]:checked').value;
            const cantidad = parseInt(document.getElementById('cantidadStock').value);

            // Calcular el cambio de stock
            let cambio = 0;
            if (tipo === 'agregar') {
                cambio = cantidad;
            } else if (tipo === 'quitar') {
                if (cantidad > productoSeleccionado.stock) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Stock insuficiente',
                        text: `Solo hay ${productoSeleccionado.stock} unidades disponibles`,
                        timer: 2000,
                        showConfirmButton: false
                    });
                    return;
                }
                cambio = -cantidad;
            } else {
                // Fijar stock - calcular la diferencia
                cambio = cantidad - productoSeleccionado.stock;
            }

            // Mostrar confirmación
            Swal.fire({
                title: '¿Confirmar actualización?',
                html: `Producto: <b>${productoSeleccionado.nombre}</b><br>
                       Stock actual: <b>${productoSeleccionado.stock}</b><br>
                       Nuevo stock: <b>${productoSeleccionado.stock + cambio}</b>`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, actualizar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    enviarActualizacion(productoId, cambio);
                }
            });
        }

        function enviarActualizacion(productoId, cambio) {
            // Mostrar indicador de carga
            Swal.fire({
                title: 'Actualizando...',
                text: 'Por favor espere',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Obtener token anti-forgery
            let token = '';
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (tokenInput) {
                token = tokenInput.value;
            } else {
                const metaToken = document.querySelector('meta[name="csrf-token"]');
                if (metaToken) {
                    token = metaToken.getAttribute('content');
                }
            }

            const requestData = {
                id: parseInt(productoId),
                cantidad: cambio
            };

            fetch('@Url.Action("ActualizarStock", "Productos")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(requestData)
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                Swal.close();

                if (data.success) {
                    modalStock.hide();
                    actualizarFilaProducto(productoId, data.nuevoStock, data.estadoStock);

                    Swal.fire({
                        icon: 'success',
                        title: 'Stock actualizado',
                        text: data.mensaje,
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 2000
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message || 'No se pudo actualizar el stock',
                        timer: 3000,
                        showConfirmButton: false
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.close();
                Swal.fire({
                    icon: 'error',
                    title: 'Error de conexión',
                    text: 'No se pudo conectar con el servidor.',
                    timer: 3000,
                    showConfirmButton: false
                });
            });
        }

        function actualizarFilaProducto(productoId, nuevoStock, estadoStock) {
            const boton = document.querySelector(`.btn-actualizar-stock[data-product-id="${productoId}"]`);
            if (!boton) return;

            const fila = boton.closest('tr');
            const stockCell = fila.querySelector('td:nth-child(5)');
            const stockDiv = stockCell.querySelector('.me-2');
            
            if (stockDiv) {
                stockDiv.textContent = nuevoStock;
                const badgeActual = stockCell.querySelector('.badge');
                if (badgeActual) {
                    badgeActual.remove();
                }
                
                const stockMinimo = parseInt(stockCell.querySelector('small').textContent.replace('Mín: ', ''));
                if (nuevoStock <= stockMinimo && nuevoStock > 0) {
                    const newBadge = document.createElement('span');
                    newBadge.className = 'badge bg-warning ms-2';
                    newBadge.innerHTML = '<i class="bi bi-exclamation-triangle"></i> Bajo';
                    stockDiv.parentNode.appendChild(newBadge);
                } else if (nuevoStock === 0) {
                    const newBadge = document.createElement('span');
                    newBadge.className = 'badge bg-danger ms-2';
                    newBadge.innerHTML = '<i class="bi bi-x-circle"></i> Agotado';
                    stockDiv.parentNode.appendChild(newBadge);
                }
            }

            const estadoCell = fila.querySelector('td:nth-child(7)');
            const estadoBadge = estadoCell.querySelector('.badge');
            if (estadoBadge) {
                let badgeClass = 'badge ';
                if (estadoStock === 'AGOTADO') {
                    badgeClass += 'bg-danger';
                } else if (estadoStock === 'BAJO') {
                    badgeClass += 'bg-warning';
                } else {
                    badgeClass += 'bg-success';
                }
                estadoBadge.className = badgeClass;
                estadoBadge.textContent = estadoStock;
            }

            boton.setAttribute('data-product-stock', nuevoStock);
        }
    </script>
}