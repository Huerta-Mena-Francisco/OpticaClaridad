﻿@using System.IO
@model OpticaClaridad.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
    ViewData["Subtitle"] = "Modificar información del producto";
}

@functions {
    // Función para convertir ruta relativa a URL pública
    string ObtenerUrlImagen(string rutaImagen)
    {
        var imagenDefault = "/Optica.jpg";

        if (string.IsNullOrEmpty(rutaImagen))
            return imagenDefault;

        // Si ya es una URL absoluta o empieza con /archivos/, mantenerla
        if (rutaImagen.StartsWith("/archivos/") || rutaImagen.StartsWith("http"))
            return rutaImagen;

        // Si es ruta antigua (empieza con /img/), intentar convertir
        if (rutaImagen.StartsWith("/img/"))
        {
            // Extraer solo el nombre del archivo de la ruta antigua
            var fileName = System.IO.Path.GetFileName(rutaImagen);
            return $"/archivos/Imagenes/Productos/{fileName}";
        }

        // Si es ruta relativa del nuevo formato (sin /archivos/)
        if (!rutaImagen.StartsWith("/"))
        {
            return $"/archivos/{rutaImagen.Replace('\\', '/')}";
        }

        return imagenDefault;
    }
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <h5 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Errores de validación</h5>
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" enctype="multipart/form-data" id="productoForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <!-- Columna izquierda - Información básica -->
                <div class="col-md-6">
                    <h5 class="mb-4"><i class="bi bi-info-circle"></i> Información Básica</h5>

                    <div class="mb-3">
                        <label asp-for="Codigo" class="form-label">Código *</label>
                        <input asp-for="Codigo" class="form-control" required>
                        <span asp-validation-for="Codigo" class="text-danger"></span>
                        <small class="text-muted">Código único para identificar el producto</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre *</label>
                        <input asp-for="Nombre" class="form-control" required>
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoriaId" class="form-label">Categoría *</label>
                        <select asp-for="CategoriaId" class="form-select" required>
                            <option value="">Seleccione una categoría</option>
                            @if (ViewBag.Categorias != null)
                            {
                                foreach (var categoria in ViewBag.Categorias)
                                {
                                    <option value="@categoria.Value" selected="@(categoria.Value == Model.CategoriaId.ToString())">
                                        @categoria.Text
                                    </option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3">@Model.Descripcion</textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Marca" class="form-label">Marca</label>
                            <input asp-for="Marca" class="form-control" value="@Model.Marca">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Modelo" class="form-label">Modelo</label>
                            <input asp-for="Modelo" class="form-control" value="@Model.Modelo">
                        </div>
                    </div>
                </div>

                <!-- Columna derecha - Precios y stock -->
                <div class="col-md-6">
                    <h5 class="mb-4"><i class="bi bi-currency-dollar"></i> Precios y Stock</h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PrecioVenta" class="form-label">Precio Venta *</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PrecioVenta" class="form-control" type="number" step="0.01" min="0.01" required value="@Model.PrecioVenta">
                            </div>
                            <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="PrecioCompra" class="form-label">Precio Compra</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PrecioCompra" class="form-control" type="number" step="0.01" min="0" value="@Model.PrecioCompra">
                            </div>
                            <span asp-validation-for="PrecioCompra" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Stock" class="form-label">Stock *</label>
                            <input asp-for="Stock" class="form-control" type="number" min="0" required value="@Model.Stock">
                            <span asp-validation-for="Stock" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="StockMinimo" class="form-label">Stock Mínimo</label>
                            <input asp-for="StockMinimo" class="form-control" type="number" min="0" value="@Model.StockMinimo">
                            <small class="text-muted">Alerta cuando el stock llegue a este nivel</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Imágenes del Producto -->
            <div class="row mt-4">
                <div class="col-12">
                    <h5 class="mb-4"><i class="bi bi-images"></i> Imágenes del Producto</h5>

                    <div class="card">
                        <div class="card-body">
                            <!-- Imágenes existentes -->
                            @if (Model.Imagenes != null && Model.Imagenes.Any(i => i.Activa))
                            {
                                <div class="mb-4">
                                    <label class="form-label">Imágenes Actuales</label>
                                    <div class="row g-3" id="imagenesExistentes">
                                        @foreach (var imagen in Model.Imagenes.Where(i => i.Activa).OrderBy(i => i.Orden))
                                        {
                                            var imagenUrl = ObtenerUrlImagen(imagen.ImagenUrl);
                                            <div class="col-6 col-md-4 col-lg-3" id="imagen-@imagen.Id">
                                                <div class="card h-100 @(imagen.EsPrincipal ? "border-primary" : "")">
                                                    <div class="card-body text-center p-2">
                                                        <img src="@imagenUrl"
                                                             class="img-fluid rounded"
                                                             style="height: 120px; object-fit: cover; width: 100%;"
                                                             alt="Imagen producto"
                                                             onerror="this.src='/Optica.jpg'">
                                                        <div class="mt-2">
                                                            <small class="d-block text-truncate">Imagen @imagen.Orden</small>
                                                            <small class="text-muted">
                                                                @if (imagen.EsPrincipal)
                                                                {
                                                                    <span class="badge bg-primary">Principal</span>
                                                                }
                                                            </small>
                                                        </div>
                                                    </div>
                                                    <div class="card-footer p-1">
                                                        @if (!imagen.EsPrincipal)
                                                        {
                                                            <a asp-action="EstablecerImagenPrincipal"
                                                               asp-route-productoId="@Model.Id"
                                                               asp-route-imagenId="@imagen.Id"
                                                               class="btn btn-sm btn-outline-primary w-100">
                                                                <i class="bi bi-star"></i> Hacer Principal
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-primary w-100" disabled>
                                                                <i class="bi bi-star-fill"></i> Principal
                                                            </button>
                                                        }
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-danger w-100 mt-1"
                                                                onclick="marcarImagenParaEliminar(@imagen.Id)">
                                                            <i class="bi bi-trash"></i> Eliminar
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Agregar nuevas imágenes -->
                            <div class="mb-4">
                                <label class="form-label">Agregar Nuevas Imágenes</label>

                                <div id="nuevasImagenesPreviewContainer" class="mb-3">
                                    <div class="row g-3" id="nuevasImagenesPreview">
                                        <!-- Las nuevas imágenes se mostrarán aquí -->
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <input type="file" class="form-control" id="nuevasImagenesFiles"
                                           name="nuevasImagenesFiles" multiple accept="image/*">
                                    <small class="text-muted">Formatos: JPG, PNG, GIF, WebP (Máx. 5MB cada una)</small>
                                </div>

                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle"></i>
                                    <span id="nuevasImagenesInfo">No hay nuevas imágenes seleccionadas</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Campo oculto para imágenes a eliminar -->
                    <input type="hidden" id="imagenesAEliminar" name="imagenesAEliminar" value="">
                </div>
            </div>

            <!-- Especificaciones para óptica -->
            <div class="row mt-4">
                <div class="col-12">
                    <h5 class="mb-4"><i class="bi bi-eyeglasses"></i> Especificaciones para Óptica</h5>
                </div>

                <div class="col-md-3 mb-3">
                    <label asp-for="TipoLente" class="form-label">Tipo de Lente</label>
                    <select asp-for="TipoLente" class="form-select">
                        <option value="">Seleccionar</option>
                        @if (ViewBag.TiposLente != null)
                        {
                            foreach (var tipo in ViewBag.TiposLente)
                            {
                                <option value="@tipo.Value" selected="@(tipo.Value == Model.TipoLente)">
                                    @tipo.Text
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3 mb-3">
                    <label asp-for="Genero" class="form-label">Para</label>
                    <select asp-for="Genero" class="form-select">
                        <option value="">Seleccionar</option>
                        @if (ViewBag.Generos != null)
                        {
                            foreach (var genero in ViewBag.Generos)
                            {
                                <option value="@genero.Value" selected="@(genero.Value == Model.Genero)">
                                    @genero.Text
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3 mb-3">
                    <label asp-for="Color" class="form-label">Color</label>
                    <input asp-for="Color" class="form-control" value="@Model.Color">
                </div>

                <div class="col-md-3 mb-3">
                    <label asp-for="Material" class="form-label">Material</label>
                    <input asp-for="Material" class="form-control" value="@Model.Material">
                </div>

                <div class="col-12">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" asp-for="TieneUV" checked="@Model.TieneUV">
                        <label class="form-check-label" asp-for="TieneUV">Protección UV</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" asp-for="TieneAntireflejante" checked="@Model.TieneAntireflejante">
                        <label class="form-check-label" asp-for="TieneAntireflejante">Antireflejante</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" asp-for="EsFotocromatico" checked="@Model.EsFotocromatico">
                        <label class="form-check-label" asp-for="EsFotocromatico">Fotocromático</label>
                    </div>
                </div>
            </div>

            <!-- Estado -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="Activo" checked="@Model.Activo">
                        <label class="form-check-label" asp-for="Activo">Producto Activo</label>
                        <small class="text-muted d-block">Si está desactivado, no aparecerá en las ventas</small>
                    </div>
                </div>
            </div>

            <!-- Botones de acción -->
            <div class="row mt-5">
                <div class="col-12">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver al listado
                        </a>
                        <div>
                            <button type="reset" class="btn btn-outline-secondary me-2">
                                <i class="bi bi-eraser"></i> Cancelar Cambios
                            </button>
                            <button type="submit" class="btn btn-primary" id="btnGuardar">
                                <i class="bi bi-save"></i> Guardar Cambios
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Array para almacenar las nuevas imágenes seleccionadas
        let nuevasImagenesSeleccionadas = [];
        let imagenesParaEliminar = [];

        // Manejar selección de nuevas imágenes
        document.getElementById('nuevasImagenesFiles').addEventListener('change', function(e) {
            const files = Array.from(e.target.files);
            const previewContainer = document.getElementById('nuevasImagenesPreview');
            const infoElement = document.getElementById('nuevasImagenesInfo');

            // Limpiar vistas anteriores (pero mantener el array)
            previewContainer.innerHTML = '';

            // Validar número máximo
            if (files.length > 10) {
                alert('Máximo 10 imágenes permitidas');
                this.value = '';
                infoElement.textContent = 'No hay nuevas imágenes seleccionadas';
                return;
            }

            // Procesar cada archivo
            files.forEach((file, index) => {
                // Validar tamaño
                if (file.size > 5 * 1024 * 1024) {
                    alert(`La imagen "${file.name}" excede el tamaño máximo de 5MB`);
                    return;
                }

                // Validar tipo
                const validTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
                if (!validTypes.includes(file.type)) {
                    alert(`La imagen "${file.name}" no tiene un formato válido`);
                    return;
                }

                // Agregar al array
                nuevasImagenesSeleccionadas.push({
                    file: file,
                    index: nuevasImagenesSeleccionadas.length
                });

                // Crear previsualización
                const reader = new FileReader();
                reader.onload = function(e) {
                    const col = document.createElement('div');
                    col.className = 'col-6 col-md-4 col-lg-3';

                    col.innerHTML = `
                        <div class="card h-100" id="nueva-preview-${index}">
                            <div class="card-body text-center p-2">
                                <img src="${e.target.result}" class="img-fluid rounded"
                                     style="height: 120px; object-fit: cover; width: 100%;">
                                <div class="mt-2">
                                    <small class="d-block text-truncate">${file.name}</small>
                                    <small class="text-muted">${(file.size / 1024).toFixed(0)} KB</small>
                                </div>
                            </div>
                            <div class="card-footer p-1">
                                <button type="button" class="btn btn-sm btn-outline-danger w-100"
                                        onclick="eliminarNuevaImagen(${index})">
                                    <i class="bi bi-trash"></i> Quitar
                                </button>
                            </div>
                        </div>
                    `;

                    previewContainer.appendChild(col);
                };
                reader.readAsDataURL(file);
            });

            // Actualizar información
            if (nuevasImagenesSeleccionadas.length > 0) {
                infoElement.textContent = `${nuevasImagenesSeleccionadas.length} nueva(s) imagen(es) seleccionada(s).`;
            } else {
                infoElement.textContent = 'No hay nuevas imágenes seleccionadas';
            }
        });

        // Función para eliminar nueva imagen
        window.eliminarNuevaImagen = function(index) {
            if (confirm('¿Quitar esta imagen?')) {
                // Remover del array
                nuevasImagenesSeleccionadas.splice(index, 1);

                // Actualizar índices del array restante
                nuevasImagenesSeleccionadas.forEach((img, i) => {
                    img.index = i;
                });

                // Reconstruir vista completa
                reconstruirVistaNuevasImagenes();
            }
        };

        // Función para reconstruir vista de nuevas imágenes
        function reconstruirVistaNuevasImagenes() {
            const previewContainer = document.getElementById('nuevasImagenesPreview');
            const infoElement = document.getElementById('nuevasImagenesInfo');

            // Limpiar
            previewContainer.innerHTML = '';

            // Si no hay imágenes, actualizar información
            if (nuevasImagenesSeleccionadas.length === 0) {
                infoElement.textContent = 'No hay nuevas imágenes seleccionadas';
                return;
            }

            // Reconstruir previsualizaciones
            nuevasImagenesSeleccionadas.forEach((img, index) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const col = document.createElement('div');
                    col.className = 'col-6 col-md-4 col-lg-3';

                    col.innerHTML = `
                        <div class="card h-100" id="nueva-preview-${index}">
                            <div class="card-body text-center p-2">
                                <img src="${e.target.result}" class="img-fluid rounded"
                                     style="height: 120px; object-fit: cover; width: 100%;">
                                <div class="mt-2">
                                    <small class="d-block text-truncate">${img.file.name}</small>
                                    <small class="text-muted">${(img.file.size / 1024).toFixed(0)} KB</small>
                                </div>
                            </div>
                            <div class="card-footer p-1">
                                <button type="button" class="btn btn-sm btn-outline-danger w-100"
                                        onclick="eliminarNuevaImagen(${index})">
                                    <i class="bi bi-trash"></i> Quitar
                                </button>
                            </div>
                        </div>
                    `;

                    previewContainer.appendChild(col);
                };
                reader.readAsDataURL(img.file);
            });

            // Actualizar información
            infoElement.textContent = `${nuevasImagenesSeleccionadas.length} nueva(s) imagen(es) seleccionada(s).`;
        }

        // Función para marcar imagen para eliminar
        window.marcarImagenParaEliminar = function(imagenId) {
            if (confirm('¿Eliminar esta imagen? Esta acción no se puede deshacer.')) {
                // Agregar al array de imágenes a eliminar
                if (!imagenesParaEliminar.includes(imagenId)) {
                    imagenesParaEliminar.push(imagenId);
                }

                // Actualizar campo oculto
                document.getElementById('imagenesAEliminar').value = imagenesParaEliminar.join(',');

                // Marcar visualmente como para eliminar
                const imagenElement = document.getElementById(`imagen-${imagenId}`);
                if (imagenElement) {
                    imagenElement.classList.add('opacity-50');
                    const btn = imagenElement.querySelector('.btn-outline-danger');
                    if (btn) {
                        btn.innerHTML = '<i class="bi bi-trash-fill"></i> Eliminar';
                        btn.classList.add('btn-danger', 'text-white');
                        btn.classList.remove('btn-outline-danger');
                    }
                }

                showToast('Imagen marcada', 'La imagen será eliminada al guardar los cambios', 'warning');
            }
        };

        // Calcular precio sugerido
        const precioCompraInput = document.getElementById('PrecioCompra');
        if (precioCompraInput) {
            precioCompraInput.addEventListener('change', function() {
                const precioCompra = parseFloat(this.value) || 0;
                const precioVentaInput = document.getElementById('PrecioVenta');

                if (precioCompra > 0 && precioVentaInput) {
                    const precioActual = parseFloat(precioVentaInput.value) || 0;
                    if (precioActual <= 0 || precioActual < precioCompra) {
                        const precioSugerido = precioCompra * 2;
                        precioVentaInput.value = precioSugerido.toFixed(2);
                        showToast('Precio sugerido', 'Se ha calculado un precio de venta sugerido', 'info');
                    }
                }
            });
        }

        // Validar formulario antes de enviar
        document.getElementById('productoForm').addEventListener('submit', function(e) {
            // Validar código
            const codigoInput = document.getElementById('Codigo');
            if (codigoInput && codigoInput.value.trim() === '') {
                e.preventDefault();
                alert('El código del producto es obligatorio');
                codigoInput.focus();
                return;
            }

            // Validar nombre
            const nombreInput = document.getElementById('Nombre');
            if (nombreInput && nombreInput.value.trim() === '') {
                e.preventDefault();
                alert('El nombre del producto es obligatorio');
                nombreInput.focus();
                return;
            }

            // Validar categoría
            const categoriaSelect = document.getElementById('CategoriaId');
            if (categoriaSelect && categoriaSelect.value === '') {
                e.preventDefault();
                alert('Debe seleccionar una categoría');
                categoriaSelect.focus();
                return;
            }

            // Confirmar si hay imágenes para eliminar
            if (imagenesParaEliminar.length > 0) {
                if (!confirm(`¿Está seguro de eliminar ${imagenesParaEliminar.length} imagen(es)? Esta acción no se puede deshacer.`)) {
                    e.preventDefault();
                    return;
                }
            }

            console.log('Guardando cambios del producto...');
        });

        // Función para mostrar notificaciones
        function showToast(title, message, type) {
            const toastHtml = `
                <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
                    <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="toast-header ${type === 'success' ? 'bg-success text-white' : type === 'warning' ? 'bg-warning text-dark' : 'bg-info text-white'}">
                            <strong class="me-auto">${title}</strong>
                            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                        <div class="toast-body">
                            ${message}
                        </div>
                    </div>
                </div>
            `;

            const toastContainer = document.createElement('div');
            toastContainer.innerHTML = toastHtml;
            document.body.appendChild(toastContainer.firstElementChild);

            setTimeout(() => {
                const toast = document.querySelector('.toast.show');
                if (toast) {
                    toast.remove();
                }
            }, 3000);
        }
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}